 "groups": [
  {
   "code": "A_general_seeking",
   "label": "Generic active seeking/searching",
   "description": "The broad, semantically neutral act of looking for, searching after, or pursuing a person, object, or goal -- the base operational sense from which the cluster's other subgroups (intensified, judicial, devotional, physical-pursuit) branch by object and context.",
   "kind": "group",
   "anchor": "Matt.7.7"
  },
  {
   "code": "B_intensified_seeking",
   "label": "Intensive/exhaustive seeking and demanding",
   "description": "Compound or intensive forms of the seeking root that add thoroughness, urgency, or added directedness to the base act -- seeking out completely, or pressing a demand/requirement to its conclusion.",
   "kind": "group",
   "anchor": "Luke.11.50"
  },
  {
   "code": "C_hostile_pursuit",
   "label": "Seeking with lethal or hostile intent",
   "description": "The idiomatic extension of seeking-vocabulary (in both Hebrew and Greek) to mean hunting a person down in order to kill, arrest, or otherwise do them harm -- 'seek the life' as a fixed hostile idiom.",
   "kind": "group",
   "anchor": "John.5.18"
  },
  {
   "code": "D_consultative_inquiry",
   "label": "Formal consultation and diligent inquiry",
   "description": "Deliberate, often institutional or cultic resort to an authority (God, an oracle, a prophet, a legal matter) for verdict, guidance, or investigation -- more studied and relational than casual searching.",
   "kind": "group",
   "anchor": "1Kgs.22.8"
  }
 ],
