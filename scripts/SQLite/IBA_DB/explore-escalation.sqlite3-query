--list of work in progress escalations
SELECT version, type,state,next_action_assigned_to,next_action, id, short_description,comment,context, resolution FROM escalation 
WHERE state not in ('completed','withdraw','closed','on-hold','supersede');
--all open escalations
SELECT id, alias, version, type,state,next_action,next_action_assigned_to, short_description,comment,context, resolution FROM escalation 
WHERE state not in ('completed','withdraw','closed','supersede');
--a specific escalation
SELECT * FROM escalation 
where id = 2110;
;

select esc.id, esc.type, eti.id as thread_item_id
,esc.short_description,
esc.comment,
esc.context,
esc.resolution,
eti.kind,
eti.note,
eti.status,
eti.value
from escalation esc
join escalation_thread_item eti on esc.id = eti.escalation_id
where eti.status not in ('completed','withdraw','closed','supersede')
;


--closed escalations
SELECT id, answered_at, resolution, short_description, type, state FROM escalation 
WHERE state in ('completed','withdraw','closed','supersede')
order by answered_at desc;


