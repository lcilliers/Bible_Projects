SELECT * FROM ib_observation;

select * from ib_node;

select * from ib_node node
where node.strong is null;

select * from cluster_subgroup;

select * from cluster;

select * from verse_lexical vl
inner join strong_verse sv on vl.strong = sv.strong
 and vl.verse_id = sv.verse_id
 and vl.deleted = 0
 inner join cluster_strong cs 
 on sv.strong = cs.strong
 and cs.deleted = 0
 and vl.strong = cs.strong
where cs.cluster_code = 'M49';

select * from wa_obs_question_catalogue cat
where cat.question_code like 'X%' 
;

select * from verse;


select * from strong;


select 
obs.id,
obs.meaning_source,
obs.obs_text,
obs.tag,
obs.window,
obs.stage,
node.*,
cat.question_code,
cat.question_text
from ib_observation obs
inner join ib_node node on obs.id = node.observation_id
left join wa_obs_question_catalogue cat 
on node.question_code = cat.question_code
;


select 
obs.id as obs_id,
node.id as node_id,
obs.meaning_source,
obs.obs_text,
obs.tag,
obs.window,
obs.stage,
s.strongNumber,
s.stepGloss,
vl.surface,
vl.role,
v.text,
v.reference,
node.cluster_subgroup_code as node_related_subgroup,
csb.label as subgroup_label,
csb.subgroup_code as strong_related_subgroup,
node.cluster_code,
c.short_name,
node.question_code,
node.strong,
v.text,
cat.question_code,
cat.`window`,
cat.question_text
from ib_observation obs
inner join ib_node node on obs.id = node.observation_id
left join wa_obs_question_catalogue cat 
on node.question_code = cat.question_code
and cat.deleted = 0
left join strong s
on node.strong = s.strongNumber
left join verse v
on node.verse_reference = v.osisId
left join cluster_strong cs
on s.strongNumber = cs.strong
and cs.deleted = 0
 -- and cs.cluster_code like 'M%'
left join cluster c
on node.cluster_code = c.cluster_code
and c.deleted = 0 
left join cluster_subgroup_strong css
on s.strongNumber = css.strong
left join cluster_subgroup csb
on css.cluster_subgroup_id= csb.id  
left join verse_lexical vl
on v.id= vl.verse_id
  and vl.strong = node.strong
  and vl.deleted = 0
  where csb.subgroup_code = 'M67_A_dispositional_idleness'
  and v.reference = '1Ti 5:13'
 and s.strongNumber = 'G4021'
 ;


select * from span span
inner join verse v on span.verse_id = v.id
where v.reference = '1Ti 5:13'
and strong_variant = 'G4021';

select * from verse where id = 8195;

select * from verse_lexical where verse_id = 8195
and strong = 'G4021'
;

