--check what is related to T2 surfaces
with t2_surfaces as (
  select distinct v.surface
  from verse_lexical v
  where v.deleted = 0
    and exists (select 1 from json_each(v.role) j where j.value = 'T2')
), m_surfaces as (
select v.surface, v.role
from verse_lexical v
where v.deleted = 0
 and exists (select 1 from json_each(v.role) j where j.value like 'M%')
 group by v.surface, v.role
)
select * from m_surfaces
inner join t2_surfaces t on m_surfaces.surface = t.surface ;

;
--t3 not in surface_subgroup
with t3_surfaces as (
  select distinct lower(trim(v.surface)) as surface
  from verse_lexical v
  where v.deleted = 0
    and exists (select 1 from json_each(v.role) j where j.value = 'T3')
    and v.surface is not null
    and trim(v.surface) <> ''
), sg_surfaces as (
  select distinct surface
  from surface_subgroup
  where deleted = 0
)
select ts.surface
from t3_surfaces ts
left join sg_surfaces sg on sg.surface = ts.surface
where sg.surface is null
order by ts.surface;