    "275878": {"gloss":"glory(b) v10","dims":[{"n":101,"l":"sense","k":"value","v":"glory (kavod - King of glory)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"the King (LORD of hosts)","to":275878,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"none","res":"none"},{"n":107,"l":"target","k":"pair","v":"none","res":"none"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"none","res":"none"},{"n":116,"l":"locus","k":"value","v":"external:god"},{"n":114,"l":"discovery","k":"note","v":"'The LORD of hosts, he is the King of GLORY (kavod)!' — the climactic answer; kavod fully disclosed as the LORD of hosts, the fivefold repetition culminating in his triumphant identity"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
