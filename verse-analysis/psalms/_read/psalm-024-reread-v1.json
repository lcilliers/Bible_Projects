    "275942": {"gloss":"glory v9","dims":[{"n":101,"l":"sense","k":"value","v":"glory (kavod - King of glory)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"the King (God)","to":275942,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"none","res":"none"},{"n":107,"l":"target","k":"pair","v":"none","res":"none"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"none","res":"none"},{"n":116,"l":"locus","k":"value","v":"external:god"},{"n":114,"l":"discovery","k":"note","v":"'that the King of GLORY (kavod) may come in' (repeated) — the antiphon renewed; the doubled summons to the gates heightens the anticipation of the glorious King's entry"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
