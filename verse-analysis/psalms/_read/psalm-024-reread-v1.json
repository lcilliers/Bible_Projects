{
  "book": "Psa", "book_id": 19, "chapter": 24, "provenance": "reread-psalms-2026",
  "note": "Ps24 (15 chars). Ascent liturgy: naqi clean hands + bar pure heart, nefesh not lifted to shav falsehood, berakah/tsedaqah/yesha reward, darash seek. Then King of glory (kavod) x5 antiphonal. Poetic ledger; span-id pairs.",
  "spans": {
    "275888": {"gloss":"clean v4","dims":[{"n":101,"l":"sense","k":"value","v":"clean / innocent (naqi - of hands)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"the one who ascends","to":275888,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"none","res":"none"},{"n":107,"l":"target","k":"pair","v":"none","res":"none"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"paired with a pure heart","from":275888,"to":275890,"res":"span"},{"n":116,"l":"locus","k":"value","v":"internal:ib-state"},{"n":114,"l":"discovery","k":"note","v":"'He who has CLEAN (naqi) hands' — outward purity of conduct; naqi (as Ps18) the innocence of the hands, first mark of the one who may ascend God's hill, paired with the inward pure heart"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "275890": {"gloss":"pure v4","dims":[{"n":101,"l":"sense","k":"value","v":"pure (bar - of heart)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"the one who ascends","to":275890,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"none","res":"none"},{"n":107,"l":"target","k":"pair","v":"none","res":"none"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"describes the heart","from":275890,"to":275891,"res":"span"},{"n":116,"l":"locus","k":"value","v":"internal:ib-state"},{"n":114,"l":"discovery","k":"note","v":"'and a PURE (bar) heart' — inward cleanness matching the clean hands; bar = the unmixed, undivided heart, the moral centre of the ascent-requirement (cf Ps18:26 the purified)"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "275891": {"gloss":"heart v4","dims":[{"n":101,"l":"sense","k":"value","v":"heart (levav)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"heart (self)","to":275891,"res":"span"},{"n":105,"l":"bearer","k":"pair","v":"the one who ascends","to":275891,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"none","res":"none"},{"n":107,"l":"target","k":"pair","v":"none","res":"none"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"is pure","from":275891,"to":275890,"res":"span"},{"n":116,"l":"locus","k":"value","v":"internal:seat"},{"n":114,"l":"discovery","k":"note","v":"the HEART (levav) that must be pure — the seat qualified for God's presence; the inward centre whose cleanness (with clean hands) fits a person to stand in the holy place"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "275895": {"gloss":"soul v4","dims":[{"n":101,"l":"sense","k":"value","v":"soul (nefesh - lifted to falsehood)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"soul (self)","to":275895,"res":"span"},{"n":105,"l":"bearer","k":"pair","v":"the one who ascends","to":275895,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"lift up (negated)","to":275895,"res":"inferred"},{"n":107,"l":"target","k":"pair","v":"what is false","from":275895,"to":275896,"res":"span"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"none","res":"none"},{"n":113,"l":"prohibition","k":"flag","v":"negated ('does NOT lift up his soul to what is false')"},{"n":116,"l":"locus","k":"value","v":"internal:seat"},{"n":114,"l":"discovery","k":"note","v":"'who does not lift up his SOUL (nefesh) to what is false' — the soul's devotion not given to idols/vanity; nefesh here the seat of longing/worship, kept from being raised to shav (falsehood) — inner fidelity as the third mark"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "275896": {"gloss":"false v4","dims":[{"n":101,"l":"sense","k":"value","v":"falsehood / vanity (shav)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"the false thing (idols/vanity)","to":275896,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"none","res":"none"},{"n":107,"l":"target","k":"pair","v":"none","res":"none"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"the soul is not lifted to it","from":275896,"to":275895,"res":"span"},{"n":113,"l":"prohibition","k":"flag","v":"the thing the soul must not be lifted to"},{"n":116,"l":"locus","k":"value","v":"external:thing"},{"n":114,"l":"discovery","k":"note","v":"'to what is FALSE (shav)' — the empty/vain thing (often an idol); shav = worthless deception, the object the pure soul refuses to set its devotion on"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "275899": {"gloss":"deceitfully v4","dims":[{"n":101,"l":"sense","k":"value","v":"deceit (mirmah - swear deceitfully, negated)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"the one who ascends (does not)","to":275899,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"none","res":"none"},{"n":107,"l":"target","k":"pair","v":"none","res":"none"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"none","res":"none"},{"n":113,"l":"prohibition","k":"flag","v":"negated ('does not swear DECEITFULLY')"},{"n":116,"l":"locus","k":"value","v":"internal:ib-state"},{"n":114,"l":"discovery","k":"note","v":"'and does not swear DECEITFULLY (mirmah)' — truthfulness in oath; mirmah (as Ps17:1's guileless lips) negated, the fourth mark — no false swearing, integrity of word completing the ascent-portrait"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "275901": {"gloss":"blessing v5","dims":[{"n":101,"l":"sense","k":"value","v":"blessing (berakah)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"the ascender (receives it)","to":275901,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"receive","to":275901,"res":"inferred"},{"n":107,"l":"target","k":"pair","v":"none","res":"none"},{"n":108,"l":"manner","k":"pair","v":"from the LORD","to":275901,"res":"inferred"},{"n":112,"l":"coupling","k":"pair","v":"paired with righteousness","from":275901,"to":275904,"res":"span"},{"n":116,"l":"locus","k":"value","v":"external:god"},{"n":114,"l":"discovery","k":"note","v":"'He will receive BLESSING (berakah) from the LORD' — the reward of the pure ascender; berakah the gift granted to the one fit to stand, paired with righteousness from the God of salvation"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "275904": {"gloss":"righteousness v5","dims":[{"n":101,"l":"sense","k":"value","v":"righteousness (tsedaqah)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"the ascender (receives it)","to":275904,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"none","res":"none"},{"n":107,"l":"target","k":"pair","v":"none","res":"none"},{"n":108,"l":"manner","k":"pair","v":"from the God of his salvation","from":275904,"to":275908,"res":"span"},{"n":112,"l":"coupling","k":"pair","v":"paired with blessing","from":275904,"to":275901,"res":"span"},{"n":116,"l":"locus","k":"value","v":"external:god"},{"n":114,"l":"discovery","k":"note","v":"'and RIGHTEOUSNESS (tsedaqah) from the God of his salvation' — righteousness as a gift received, not achieved; tsedaqah bestowed on the ascender, vindication from the saving God"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "275908": {"gloss":"salvation v5","dims":[{"n":101,"l":"sense","k":"value","v":"salvation (yesha - God of his salvation)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"the ascender (God his salvation)","to":275908,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"none","res":"none"},{"n":107,"l":"target","k":"pair","v":"none","res":"none"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"the source of righteousness","from":275908,"to":275904,"res":"span"},{"n":116,"l":"locus","k":"value","v":"external:god"},{"n":114,"l":"discovery","k":"note","v":"'the God of his SALVATION (yesha)' — God titled as the ascender's salvation; yesha the source from which blessing and righteousness flow to the pure"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "275911": {"gloss":"seek v6","dims":[{"n":101,"l":"sense","k":"value","v":"seek (darash)"},{"n":102,"l":"type","k":"value","v":"action"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"the generation of seekers","to":275911,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"seek"},{"n":107,"l":"target","k":"pair","v":"God (his face)","to":275911,"res":"inferred"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"none","res":"none"},{"n":116,"l":"locus","k":"value","v":"external:god"},{"n":114,"l":"discovery","k":"note","v":"'the generation of those who SEEK (darash) him, who seek the face of the God of Jacob' — the seekers defined; darash (as Ps22:26) the earnest pursuit of God's face, the mark of the true worshipping generation"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "275923": {"gloss":"glory v7","dims":[{"n":101,"l":"sense","k":"value","v":"glory (kavod - King of glory)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"the King (God)","to":275923,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"none","res":"none"},{"n":107,"l":"target","k":"pair","v":"none","res":"none"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"none","res":"none"},{"n":116,"l":"locus","k":"value","v":"external:god"},{"n":114,"l":"discovery","k":"note","v":"'that the King of GLORY (kavod) may come in' — the entrance of the glorious King; kavod the weighty splendour of God the gates must open for, first of the fivefold antiphon"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
