{
  "book": "Psa", "book_id": 19, "chapter": 25, "provenance": "reread-psalms-2026",
  "note": "Ps25 (48 chars, acrostic). Trust+pardon. zakar x3 (remember mercy / remember NOT sins / remember me), chesed x3 (v6,7,10), nefesh x3 (v1 lifted/v13 abides/v20 guarded), tov/yashar cluster (God good+upright teaches sinners), yare God-fearers instructed, tom/yosher integrity. Poetic ledger; span-id pairs.",
  "spans": {
    "275948": {"gloss":"soul v1","dims":[{"n":101,"l":"sense","k":"value","v":"soul (nefesh - lift up my soul)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"soul (self)","to":275948,"res":"span"},{"n":105,"l":"bearer","k":"pair","v":"David","to":275948,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"lift up (to God)","to":275948,"res":"inferred"},{"n":107,"l":"target","k":"pair","v":"the LORD","to":275948,"res":"inferred"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"none","res":"none"},{"n":116,"l":"locus","k":"value","v":"internal:seat"},{"n":114,"l":"discovery","k":"note","v":"'To you, O LORD, I lift up my SOUL (nefesh)' — the whole self raised to God in trust; nefesh lifted Godward (opposite of Ps24:4's soul lifted to falsehood), the opening posture of surrender"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "276026": {"gloss":"trust v2","dims":[{"n":101,"l":"sense","k":"value","v":"trust (batach)"},{"n":102,"l":"type","k":"value","v":"action"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"David","to":276026,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"trust"},{"n":107,"l":"target","k":"pair","v":"God","to":276026,"res":"inferred"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"paired with not being shamed","from":276026,"to":276028,"res":"span"},{"n":116,"l":"locus","k":"value","v":"external:god"},{"n":114,"l":"discovery","k":"note","v":"'in you I TRUST (batach); let me not be put to shame' — reliance seeking vindication; batach the confidence that pleads against disgrace, the ground of the whole acrostic"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "276028": {"gloss":"put to shame v2","dims":[{"n":101,"l":"sense","k":"value","v":"be put to shame (bosh, negated plea)"},{"n":102,"l":"type","k":"value","v":"action"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"David","to":276028,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"be put to shame (deprecated)"},{"n":107,"l":"target","k":"pair","v":"none","res":"none"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"the fear the trust resists","from":276028,"to":276026,"res":"span"},{"n":113,"l":"prohibition","k":"flag","v":"deprecated ('let me NOT be put to shame')"},{"n":116,"l":"locus","k":"value","v":"internal:ib-state"},{"n":114,"l":"discovery","k":"note","v":"'let me not be put to SHAME (bosh)' — the dread the trusting soul prays against; bosh opens the shame-thread (v3x2, v20), disgrace as the opposite of vindicated trust"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "276032": {"gloss":"exult v2","dims":[{"n":101,"l":"sense","k":"value","v":"exult / triumph (alats)"},{"n":102,"l":"type","k":"value","v":"action"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"the enemies","to":276032,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"exult over"},{"n":107,"l":"target","k":"pair","v":"David","to":276032,"res":"inferred"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"none","res":"none"},{"n":116,"l":"locus","k":"value","v":"external:person"},{"n":114,"l":"discovery","k":"note","v":"'let not my enemies EXULT (alats) over me' — the foe's malicious triumph feared; alats = gloating exultation, the enemy's joy at the believer's shame that God is asked to prevent"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "276059": {"gloss":"put to shame v3","dims":[{"n":101,"l":"sense","k":"value","v":"be put to shame (bosh, negated of the waiting)"},{"n":102,"l":"type","k":"value","v":"action"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"those who wait for God","to":276059,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"be put to shame (negated)"},{"n":107,"l":"target","k":"pair","v":"none","res":"none"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"contrasted with the shamed treacherous","from":276059,"to":276060,"res":"span"},{"n":113,"l":"prohibition","k":"flag","v":"negated ('none who wait shall be put to shame')"},{"n":116,"l":"locus","k":"value","v":"internal:ib-state"},{"n":114,"l":"discovery","k":"note","v":"'none who WAIT for you shall be put to SHAME (bosh)' — the general truth grounding the personal plea; bosh negated for the waiters, the reliable rule the psalmist claims"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "276060": {"gloss":"ashamed v3","dims":[{"n":101,"l":"sense","k":"value","v":"be ashamed (bosh - of the treacherous)"},{"n":102,"l":"type","k":"value","v":"action"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"the wantonly treacherous","from":276060,"to":276062,"res":"span"},{"n":106,"l":"operation","k":"event","v":"be ashamed"},{"n":107,"l":"target","k":"pair","v":"none","res":"none"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"contrasted with the un-shamed waiters","from":276060,"to":276059,"res":"span"},{"n":116,"l":"locus","k":"value","v":"internal:ib-state"},{"n":114,"l":"discovery","k":"note","v":"'they shall be ASHAMED (bosh) who are wantonly treacherous' — shame reassigned to the faithless; the same verb that spares the waiters falls on the treacherous, the just reversal"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "276062": {"gloss":"treacherous v3","dims":[{"n":101,"l":"sense","k":"value","v":"deal treacherously (bagad)"},{"n":102,"l":"type","k":"value","v":"action"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"the treacherous","to":276062,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"deal treacherously"},{"n":107,"l":"target","k":"pair","v":"none","res":"none"},{"n":108,"l":"manner","k":"pair","v":"wantonly / without cause","to":276062,"res":"inferred"},{"n":112,"l":"coupling","k":"pair","v":"they are the ones shamed","from":276062,"to":276060,"res":"span"},{"n":116,"l":"locus","k":"value","v":"internal:ib-state"},{"n":114,"l":"discovery","k":"note","v":"'who are wantonly TREACHEROUS (bagad)' — faithlessness without cause; bagad = covenant-betrayal, the disposition opposite to the waiting trust, justly put to shame"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "306186": {"gloss":"know v4","dims":[{"n":101,"l":"sense","k":"value","v":"make known / teach (yada, hiphil)"},{"n":102,"l":"type","k":"value","v":"action"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"God (asked to)","to":306186,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"make known"},{"n":107,"l":"target","k":"pair","v":"David ('your ways')","to":306186,"res":"inferred"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"none","res":"none"},{"n":116,"l":"locus","k":"value","v":"external:god"},{"n":114,"l":"discovery","k":"note","v":"'Make me to KNOW (yada) your ways; teach me your paths' — the plea for divine instruction; yada here the imparted knowledge of God's ways, the teachable heart's request"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "276064": {"gloss":"truth v5","dims":[{"n":101,"l":"sense","k":"value","v":"truth (emeth - lead me in your truth)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"God (his truth)","to":276064,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"none","res":"none"},{"n":107,"l":"target","k":"pair","v":"David (led in it)","to":276064,"res":"inferred"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"none","res":"none"},{"n":116,"l":"locus","k":"value","v":"external:god"},{"n":114,"l":"discovery","k":"note","v":"'Lead me in your TRUTH (emeth) and teach me' — God's truth as the path to walk; emeth here the reliable way of God the psalmist asks to be led along (recurs v10 as faithfulness)"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "276068": {"gloss":"salvation v5","dims":[{"n":101,"l":"sense","k":"value","v":"salvation (yesha - God of my salvation)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"David (God his salvation)","to":276068,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"none","res":"none"},{"n":107,"l":"target","k":"pair","v":"none","res":"none"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"none","res":"none"},{"n":116,"l":"locus","k":"value","v":"external:god"},{"n":114,"l":"discovery","k":"note","v":"'for you are the God of my SALVATION (yesha); for you I wait all the day' — salvation the reason for waiting; yesha grounds the day-long expectation"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "276072": {"gloss":"Remember(mercy) v6","dims":[{"n":101,"l":"sense","k":"value","v":"remember (zakar)"},{"n":102,"l":"type","k":"value","v":"action"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"God (asked to)","to":276072,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"remember"},{"n":107,"l":"target","k":"pair","v":"your mercy and steadfast love","from":276072,"to":276073,"res":"span"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"none","res":"none"},{"n":116,"l":"locus","k":"value","v":"external:god"},{"n":114,"l":"discovery","k":"note","v":"'REMEMBER (zakar) your mercy, O LORD, and your steadfast love' — the first of three zakar: God asked to remember his OWN compassion; zakar Godward, appealing to the ancient love"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "276073": {"gloss":"mercy v6","dims":[{"n":101,"l":"sense","k":"value","v":"mercy / compassion (racham)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"God","to":276073,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"none","res":"none"},{"n":107,"l":"target","k":"pair","v":"none","res":"none"},{"n":108,"l":"manner","k":"pair","v":"from of old","to":276073,"res":"inferred"},{"n":112,"l":"coupling","k":"pair","v":"paired with steadfast love","from":276073,"to":276075,"res":"span"},{"n":116,"l":"locus","k":"value","v":"external:god"},{"n":114,"l":"discovery","k":"note","v":"'your MERCY (racham)... from of old' — God's tender compassion appealed to; racham (womb-love, cf Ps18:1) the eternal mercy paired with chesed as the ground of pardon"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "276075": {"gloss":"steadfast love v6","dims":[{"n":101,"l":"sense","k":"value","v":"steadfast love (chesed)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"God","to":276075,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"none","res":"none"},{"n":107,"l":"target","k":"pair","v":"none","res":"none"},{"n":108,"l":"manner","k":"pair","v":"from of old","to":276075,"res":"inferred"},{"n":112,"l":"coupling","k":"pair","v":"paired with mercy","from":276075,"to":276073,"res":"span"},{"n":116,"l":"locus","k":"value","v":"external:god"},{"n":114,"l":"discovery","k":"note","v":"'and your CHESED (steadfast love), for they have been from of old' — the first of three chesed (v6,7,10); the ancient covenant love the whole psalm leans on"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "276080": {"gloss":"Remember-not(sins) v7","dims":[{"n":101,"l":"sense","k":"value","v":"remember (zakar - not the sins of my youth)"},{"n":102,"l":"type","k":"value","v":"action"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"God (asked NOT to)","to":276080,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"remember (negated)"},{"n":107,"l":"target","k":"pair","v":"the sins of my youth","from":276080,"to":276082,"res":"span"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"none","res":"none"},{"n":113,"l":"prohibition","k":"flag","v":"negated ('REMEMBER NOT the sins of my youth')"},{"n":116,"l":"locus","k":"value","v":"external:god"},{"n":114,"l":"discovery","k":"note","v":"'REMEMBER NOT (zakar) the sins of my youth' — the second zakar, now the plea for divine forgetting; the paradox of divine memory: remember your love, forget my sin"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "276082": {"gloss":"sins v7","dims":[{"n":101,"l":"sense","k":"value","v":"sins (chattath)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"David (the sins of his youth)","to":276082,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"none","res":"none"},{"n":107,"l":"target","k":"pair","v":"none","res":"none"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"paired with transgressions","from":276082,"to":276084,"res":"span"},{"n":116,"l":"locus","k":"value","v":"internal:ib-state"},{"n":114,"l":"discovery","k":"note","v":"'the SINS (chattath) of my youth' — the failures God is asked to forget; chattath = missings-of-the-mark, the youthful faults paired with pesha (transgressions)"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "276084": {"gloss":"transgressions v7","dims":[{"n":101,"l":"sense","k":"value","v":"transgressions (pesha)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"David","to":276084,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"none","res":"none"},{"n":107,"l":"target","k":"pair","v":"none","res":"none"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"paired with sins","from":276084,"to":276082,"res":"span"},{"n":116,"l":"locus","k":"value","v":"internal:ib-state"},{"n":114,"l":"discovery","k":"note","v":"'or my TRANSGRESSIONS (pesha)' — the rebellions alongside the sins; pesha (as Ps19:13) the deliberate breaches, both laid under the appeal to be forgotten"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "276086": {"gloss":"steadfast love v7","dims":[{"n":101,"l":"sense","k":"value","v":"steadfast love (chesed)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"God","to":276086,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"none","res":"none"},{"n":107,"l":"target","k":"pair","v":"remember me according to it","from":276086,"to":276087,"res":"span"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"none","res":"none"},{"n":116,"l":"locus","k":"value","v":"external:god"},{"n":114,"l":"discovery","k":"note","v":"'according to your CHESED (steadfast love) remember me' — the second chesed; the measure of the desired remembrance is God's love, not the psalmist's merit"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "276087": {"gloss":"remember-me v7","dims":[{"n":101,"l":"sense","k":"value","v":"remember (zakar - remember ME)"},{"n":102,"l":"type","k":"value","v":"action"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"God (asked to)","to":276087,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"remember"},{"n":107,"l":"target","k":"pair","v":"David ('me')","to":276087,"res":"inferred"},{"n":108,"l":"manner","k":"pair","v":"according to your steadfast love","from":276087,"to":276086,"res":"span"},{"n":112,"l":"coupling","k":"pair","v":"none","res":"none"},{"n":116,"l":"locus","k":"value","v":"external:god"},{"n":114,"l":"discovery","k":"note","v":"'REMEMBER ME (zakar), for the sake of your goodness' — the third zakar completing the paradox: remember your love (v6), forget my sin (v7a), remember ME (v7b) — divine memory bent wholly toward grace"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "276090": {"gloss":"goodness v7","dims":[{"n":101,"l":"sense","k":"value","v":"goodness (tov)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"God","to":276090,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"none","res":"none"},{"n":107,"l":"target","k":"pair","v":"none","res":"none"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"none","res":"none"},{"n":116,"l":"locus","k":"value","v":"external:god"},{"n":114,"l":"discovery","k":"note","v":"'for the sake of your GOODNESS (tov), O LORD' — God's goodness as the motive of pardon; tov opens the goodness-cluster (v8 Good, v13 well-being), grace grounded in who God is"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "276092": {"gloss":"Good v8","dims":[{"n":101,"l":"sense","k":"value","v":"good (tov - Good is the LORD)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"the LORD","to":276092,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"none","res":"none"},{"n":107,"l":"target","k":"pair","v":"none","res":"none"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"paired with upright","from":276092,"to":276093,"res":"span"},{"n":116,"l":"locus","k":"value","v":"external:god"},{"n":114,"l":"discovery","k":"note","v":"'GOOD (tov) and upright is the LORD; therefore he instructs sinners' — God's goodness is why he teaches even sinners the way; tov here the divine character that stoops to instruct the failing"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "276093": {"gloss":"upright v8","dims":[{"n":101,"l":"sense","k":"value","v":"upright (yashar)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"the LORD","to":276093,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"none","res":"none"},{"n":107,"l":"target","k":"pair","v":"none","res":"none"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"paired with good","from":276093,"to":276092,"res":"span"},{"n":116,"l":"locus","k":"value","v":"external:god"},{"n":114,"l":"discovery","k":"note","v":"'good and UPRIGHT (yashar) is the LORD' — God's rectitude twinned with his goodness; yashar (recurs v21 of human uprightness) the straightness that yet teaches the crooked sinner"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "276097": {"gloss":"sinners v8","dims":[{"n":101,"l":"sense","k":"value","v":"sinners (chatta)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"sinners (instructed by God)","to":276097,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"none","res":"none"},{"n":107,"l":"target","k":"pair","v":"none","res":"none"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"none","res":"none"},{"n":116,"l":"locus","k":"value","v":"external:person"},{"n":114,"l":"discovery","k":"note","v":"'he instructs SINNERS (chatta) in the way' — the objects of God's teaching grace; chatta = habitual sinners, whom the good God yet stoops to guide, the astonishing reach of his instruction"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "276100": {"gloss":"humble(a) v9","dims":[{"n":101,"l":"sense","k":"value","v":"humble / afflicted (anav)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"the humble (led by God)","to":276100,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"none","res":"none"},{"n":107,"l":"target","k":"pair","v":"none","res":"none"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"repeated in the verse","from":276100,"to":276103,"res":"span"},{"n":116,"l":"locus","k":"value","v":"internal:ib-state"},{"n":114,"l":"discovery","k":"note","v":"'He leads the HUMBLE (anav) in what is right' — the humble as God's teachable ones; anav = the lowly/bowed, whom God guides in justice, the disposition that receives instruction"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "276103": {"gloss":"humble(b) v9","dims":[{"n":101,"l":"sense","k":"value","v":"humble (anav, repeated)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"the humble","to":276103,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"none","res":"none"},{"n":107,"l":"target","k":"pair","v":"none","res":"none"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"emphatic doubling","from":276103,"to":276100,"res":"span"},{"n":116,"l":"locus","k":"value","v":"internal:ib-state"},{"n":114,"l":"discovery","k":"note","v":"'and teaches the HUMBLE (anav) his way' — the doubled anav; humility repeated as the sole condition of being taught God's way, the lowly alone are teachable"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "275952": {"gloss":"steadfast love v10","dims":[{"n":101,"l":"sense","k":"value","v":"steadfast love (chesed)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"God (all his paths)","to":275952,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"none","res":"none"},{"n":107,"l":"target","k":"pair","v":"those who keep his covenant","to":275952,"res":"inferred"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"paired with faithfulness","from":275952,"to":275953,"res":"span"},{"n":116,"l":"locus","k":"value","v":"external:god"},{"n":114,"l":"discovery","k":"note","v":"'All the paths of the LORD are CHESED (steadfast love) and faithfulness' — the third chesed; God's every way toward the covenant-keeper is love and truth, the character behind all his dealings"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "275953": {"gloss":"faithfulness v10","dims":[{"n":101,"l":"sense","k":"value","v":"faithfulness / truth (emeth)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"God","to":275953,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"none","res":"none"},{"n":107,"l":"target","k":"pair","v":"none","res":"none"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"paired with steadfast love","from":275953,"to":275952,"res":"span"},{"n":116,"l":"locus","k":"value","v":"external:god"},{"n":114,"l":"discovery","k":"note","v":"'chesed and FAITHFULNESS (emeth)' — God's reliability paired with his love; emeth (recurs from v5) the truth that all his paths embody toward those who keep covenant"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "275962": {"gloss":"pardon v11","dims":[{"n":101,"l":"sense","k":"value","v":"pardon / forgive (salach)"},{"n":102,"l":"type","k":"value","v":"action"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"God (asked to)","to":275962,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"pardon"},{"n":107,"l":"target","k":"pair","v":"my guilt","from":275962,"to":275963,"res":"span"},{"n":108,"l":"manner","k":"pair","v":"for your name's sake","to":275962,"res":"inferred"},{"n":112,"l":"coupling","k":"pair","v":"none","res":"none"},{"n":116,"l":"locus","k":"value","v":"external:god"},{"n":114,"l":"discovery","k":"note","v":"'For your name's sake, PARDON (salach) my guilt, for it is great' — the bold plea; salach (the verb used only of God's forgiving) sought precisely because the guilt is great, God's honour the ground of pardon"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "275963": {"gloss":"guilt v11","dims":[{"n":101,"l":"sense","k":"value","v":"guilt / iniquity (avon)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"David","to":275963,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"none","res":"none"},{"n":107,"l":"target","k":"pair","v":"none","res":"none"},{"n":108,"l":"manner","k":"pair","v":"great","to":275963,"res":"inferred"},{"n":112,"l":"coupling","k":"pair","v":"pardoned by God","from":275963,"to":275962,"res":"span"},{"n":116,"l":"locus","k":"value","v":"internal:ib-state"},{"n":114,"l":"discovery","k":"note","v":"'pardon my GUILT (avon), for it is great' — iniquity confessed as vast; avon (as Ps18:23) the crookedness whose very greatness becomes the argument for mercy, not despair"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "275969": {"gloss":"fears v12","dims":[{"n":101,"l":"sense","k":"value","v":"fear (yare - who fears the LORD)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"the God-fearer","to":275969,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"none","res":"none"},{"n":107,"l":"target","k":"pair","v":"none","res":"none"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"none","res":"none"},{"n":116,"l":"locus","k":"value","v":"external:god"},{"n":114,"l":"discovery","k":"note","v":"'Who is the man who FEARS (yare) the LORD? Him will he instruct' — the God-fearer as the one God teaches; yare the reverence that qualifies for divine guidance (paired with v14)"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "275974": {"gloss":"soul v13","dims":[{"n":101,"l":"sense","k":"value","v":"soul (nefesh - shall abide in well-being)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"soul (self)","to":275974,"res":"span"},{"n":105,"l":"bearer","k":"pair","v":"the God-fearer","to":275974,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"none","res":"none"},{"n":107,"l":"target","k":"pair","v":"none","res":"none"},{"n":108,"l":"manner","k":"pair","v":"in well-being","from":275974,"to":275976,"res":"span"},{"n":112,"l":"coupling","k":"pair","v":"none","res":"none"},{"n":116,"l":"locus","k":"value","v":"internal:seat"},{"n":114,"l":"discovery","k":"note","v":"'His SOUL (nefesh) shall abide in well-being' — the second nefesh; the God-fearer's life resting in good, the blessed repose that answers the lifted soul of v1"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "275976": {"gloss":"well-being v13","dims":[{"n":101,"l":"sense","k":"value","v":"good / well-being (tov)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"the God-fearer's soul","from":275976,"to":275974,"res":"span"},{"n":106,"l":"operation","k":"event","v":"none","res":"none"},{"n":107,"l":"target","k":"pair","v":"none","res":"none"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"the soul abides in it","from":275976,"to":275974,"res":"span"},{"n":116,"l":"locus","k":"value","v":"internal:ib-state"},{"n":114,"l":"discovery","k":"note","v":"'abide in WELL-BEING (tov)' — the good estate of the God-fearer; tov here the fullness of life (completing the goodness-cluster v7,8), the soul lodged in God's good"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "275982": {"gloss":"fear v14","dims":[{"n":101,"l":"sense","k":"value","v":"fear (yare - those who fear him)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"the God-fearers","to":275982,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"none","res":"none"},{"n":107,"l":"target","k":"pair","v":"none","res":"none"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"to whom God reveals his covenant","from":275982,"to":275983,"res":"span"},{"n":116,"l":"locus","k":"value","v":"external:god"},{"n":114,"l":"discovery","k":"note","v":"'The friendship of the LORD is for those who FEAR (yare) him' — intimacy given to the reverent; yare (recurs v12) the fear that receives God's secret counsel and covenant"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "275983": {"gloss":"known v14","dims":[{"n":101,"l":"sense","k":"value","v":"make known (yada, hiphil - his covenant)"},{"n":102,"l":"type","k":"value","v":"action"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"God","to":275983,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"make known"},{"n":107,"l":"target","k":"pair","v":"the God-fearers","from":275983,"to":275982,"res":"span"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"none","res":"none"},{"n":116,"l":"locus","k":"value","v":"external:god"},{"n":114,"l":"discovery","k":"note","v":"'he makes KNOWN (yada) to them his covenant' — the disclosure of God's covenant to the reverent; yada here God revealing his secret to the God-fearers, intimacy as knowledge shared"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "275998": {"gloss":"gracious v16","dims":[{"n":101,"l":"sense","k":"value","v":"be gracious (chanan)"},{"n":102,"l":"type","k":"value","v":"action"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"God (asked to)","to":275998,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"be gracious"},{"n":107,"l":"target","k":"pair","v":"David","to":275998,"res":"inferred"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"paired with lonely+afflicted","from":275998,"to":276002,"res":"span"},{"n":116,"l":"locus","k":"value","v":"external:god"},{"n":114,"l":"discovery","k":"note","v":"'Turn to me and be GRACIOUS (chanan), for I am lonely and afflicted' — the plea for favour in isolation; chanan = the free grace the destitute soul begs, God's turning toward the lonely"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "276002": {"gloss":"afflicted v16","dims":[{"n":101,"l":"sense","k":"value","v":"afflicted (ani)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"David","to":276002,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"none","res":"none"},{"n":107,"l":"target","k":"pair","v":"none","res":"none"},{"n":108,"l":"manner","k":"pair","v":"lonely","to":276002,"res":"inferred"},{"n":112,"l":"coupling","k":"pair","v":"the ground of the plea for grace","from":276002,"to":275998,"res":"span"},{"n":116,"l":"locus","k":"value","v":"internal:ib-state"},{"n":114,"l":"discovery","k":"note","v":"'for I am lonely and AFFLICTED (ani)' — the low estate moving the plea; ani (as Ps22:24) the afflicted one whose very misery is the appeal to God's grace"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "276004": {"gloss":"heart v17","dims":[{"n":101,"l":"sense","k":"value","v":"heart (levav - troubles of my heart)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"heart (self)","to":276004,"res":"span"},{"n":105,"l":"bearer","k":"pair","v":"David","to":276004,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"none","res":"none"},{"n":107,"l":"target","k":"pair","v":"none","res":"none"},{"n":108,"l":"manner","k":"pair","v":"enlarged / multiplied","to":276004,"res":"inferred"},{"n":112,"l":"coupling","k":"pair","v":"none","res":"none"},{"n":116,"l":"locus","k":"value","v":"internal:seat"},{"n":114,"l":"discovery","k":"note","v":"'The troubles of my HEART (levav) are enlarged' — inward distress swelling; levav the seat where the psalmist's afflictions multiply, from which he begs to be brought out"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "276011": {"gloss":"affliction v18","dims":[{"n":101,"l":"sense","k":"value","v":"affliction (oni)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"David","to":276011,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"none","res":"none"},{"n":107,"l":"target","k":"pair","v":"none","res":"none"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"paired with trouble","from":276011,"to":276012,"res":"span"},{"n":116,"l":"locus","k":"value","v":"internal:ib-state"},{"n":114,"l":"discovery","k":"note","v":"'Consider my AFFLICTION (oni) and my trouble, and forgive all my sins' — suffering and sin brought together before God; oni = the misery God is asked to see, joined to the plea for pardon"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "276012": {"gloss":"trouble v18","dims":[{"n":101,"l":"sense","k":"value","v":"trouble / toil (amal)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"David","to":276012,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"none","res":"none"},{"n":107,"l":"target","k":"pair","v":"none","res":"none"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"paired with affliction","from":276012,"to":276011,"res":"span"},{"n":116,"l":"locus","k":"value","v":"internal:ib-state"},{"n":114,"l":"discovery","k":"note","v":"'my TROUBLE (amal)' — the toilsome burden alongside affliction; amal = wearisome hardship, the second word of the suffering-pair God is asked to consider"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "276016": {"gloss":"sins v18","dims":[{"n":101,"l":"sense","k":"value","v":"sins (chattath - forgive all my sins)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"David","to":276016,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"none","res":"none"},{"n":107,"l":"target","k":"pair","v":"none","res":"none"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"none","res":"none"},{"n":116,"l":"locus","k":"value","v":"internal:ib-state"},{"n":114,"l":"discovery","k":"note","v":"'and forgive all my SINS (chattath)' — the comprehensive plea; chattath (recurs v7) here 'all', the sufferer asking that affliction and every sin alike be lifted"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "276021": {"gloss":"violent v19","dims":[{"n":101,"l":"sense","k":"value","v":"violence (chamas)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"the foes (their hatred)","from":276021,"to":276022,"res":"span"},{"n":106,"l":"operation","k":"event","v":"none","res":"none"},{"n":107,"l":"target","k":"pair","v":"none","res":"none"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"qualifies their hatred","from":276021,"to":276022,"res":"span"},{"n":116,"l":"locus","k":"value","v":"internal:ib-state"},{"n":114,"l":"discovery","k":"note","v":"'with what VIOLENT (chamas) hatred they hate me' — the ferocity of the foes' enmity; chamas = violence, here intensifying the hatred, the cruelty of the opposition"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "276022": {"gloss":"hatred v19","dims":[{"n":101,"l":"sense","k":"value","v":"hatred (sinah)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"the foes","to":276022,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"none","res":"none"},{"n":107,"l":"target","k":"pair","v":"David","to":276022,"res":"inferred"},{"n":108,"l":"manner","k":"pair","v":"violent","from":276022,"to":276021,"res":"span"},{"n":112,"l":"coupling","k":"pair","v":"enacted in their hating","from":276022,"to":276023,"res":"span"},{"n":116,"l":"locus","k":"value","v":"internal:ib-state"},{"n":114,"l":"discovery","k":"note","v":"'violent HATRED (sinah) they hate me' — the settled enmity itself; sinah = hatred as a state, the noun behind the verb sane, the inner malice of the many foes"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "276023": {"gloss":"hate v19","dims":[{"n":101,"l":"sense","k":"value","v":"hate (sane)"},{"n":102,"l":"type","k":"value","v":"action"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"the foes","to":276023,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"hate"},{"n":107,"l":"target","k":"pair","v":"David","to":276023,"res":"inferred"},{"n":108,"l":"manner","k":"pair","v":"with violent hatred","from":276023,"to":276022,"res":"span"},{"n":112,"l":"coupling","k":"pair","v":"none","res":"none"},{"n":116,"l":"locus","k":"value","v":"external:person"},{"n":114,"l":"discovery","k":"note","v":"'they HATE (sane) me' — the act of enmity; sane (recurs Ps18,22) the verb of active hatred, the foes' hostility that presses the psalmist to seek refuge in God"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "276035": {"gloss":"soul v20","dims":[{"n":101,"l":"sense","k":"value","v":"soul (nefesh - guard my soul)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"soul (self)","to":276035,"res":"span"},{"n":105,"l":"bearer","k":"pair","v":"David","to":276035,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"none","res":"none"},{"n":107,"l":"target","k":"pair","v":"guarded by God","to":276035,"res":"inferred"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"paired with taking refuge","from":276035,"to":276040,"res":"span"},{"n":116,"l":"locus","k":"value","v":"internal:seat"},{"n":114,"l":"discovery","k":"note","v":"'Oh, guard my SOUL (nefesh), and deliver me' — the third nefesh; the life-self committed to God's keeping (v1 lifted, v13 abiding, v20 guarded — the soul's arc through the psalm)"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "276038": {"gloss":"put to shame v20","dims":[{"n":101,"l":"sense","k":"value","v":"be put to shame (bosh, negated plea)"},{"n":102,"l":"type","k":"value","v":"action"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"David","to":276038,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"be put to shame (deprecated)"},{"n":107,"l":"target","k":"pair","v":"none","res":"none"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"because he takes refuge in God","from":276038,"to":276040,"res":"span"},{"n":113,"l":"prohibition","k":"flag","v":"deprecated ('Let me NOT be put to shame')"},{"n":116,"l":"locus","k":"value","v":"internal:ib-state"},{"n":114,"l":"discovery","k":"note","v":"'Let me not be put to SHAME (bosh), for I take refuge in you' — the shame-thread closes (v2,3) grounded now in refuge; the one who shelters in God will not be disgraced"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "276040": {"gloss":"take refuge v20","dims":[{"n":101,"l":"sense","k":"value","v":"take refuge (chasah)"},{"n":102,"l":"type","k":"value","v":"action"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"David","to":276040,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"take refuge"},{"n":107,"l":"target","k":"pair","v":"God","to":276040,"res":"inferred"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"the ground against shame","from":276040,"to":276038,"res":"span"},{"n":116,"l":"locus","k":"value","v":"external:god"},{"n":114,"l":"discovery","k":"note","v":"'for I TAKE REFUGE (chasah) in you' — the sheltering that guarantees against shame; chasah (recurs Ps16,17,18) the fleeing-to-God on which the whole plea for guarding rests"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "276042": {"gloss":"integrity v21","dims":[{"n":101,"l":"sense","k":"value","v":"integrity / completeness (tom)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"David (may it preserve him)","to":276042,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"preserve","to":276042,"res":"inferred"},{"n":107,"l":"target","k":"pair","v":"David","to":276042,"res":"inferred"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"paired with uprightness","from":276042,"to":276043,"res":"span"},{"n":116,"l":"locus","k":"value","v":"internal:ib-state"},{"n":114,"l":"discovery","k":"note","v":"'May INTEGRITY (tom) and uprightness preserve me' — the psalmist's wholeness asked to guard him; tom (root of tamim) the blamelessness that, with uprightness, shields the one who waits on God"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "276043": {"gloss":"uprightness v21","dims":[{"n":101,"l":"sense","k":"value","v":"uprightness (yosher)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"David","to":276043,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"none","res":"none"},{"n":107,"l":"target","k":"pair","v":"none","res":"none"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"paired with integrity","from":276043,"to":276042,"res":"span"},{"n":116,"l":"locus","k":"value","v":"internal:ib-state"},{"n":114,"l":"discovery","k":"note","v":"'and UPRIGHTNESS (yosher) preserve me' — straightness of life twinned with integrity; yosher (cf God's yashar v8) the human rectitude that guards the one waiting for God"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
