  "note": "Ps20 (12 chars). Intercession for the king. zakar links v3 (God remembers offerings) / v7 (we invoke the name). Salvation cluster yeshuah/yasha/yesha x4. Trust-contrast v7 chariots vs the name. Poetic ledger; span-id pairs.",
  "spans": {
    "275416": {"gloss":"remember v3","dims":[{"n":101,"l":"sense","k":"value","v":"remember / regard (zakar)"},{"n":102,"l":"type","k":"value","v":"action"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"God","to":275416,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"remember"},{"n":107,"l":"target","k":"pair","v":"the king's offerings","to":275416,"res":"inferred"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"none","res":"none"},{"n":116,"l":"locus","k":"value","v":"external:god"},{"n":114,"l":"discovery","k":"note","v":"'May he REMEMBER (zakar) all your offerings' — God's gracious recollection of the king's worship; zakar here Godward-directed (contrast v7 where WE invoke by remembering), remembrance as favour toward the offerer"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "275423": {"gloss":"heart's desire v4","dims":[{"n":101,"l":"sense","k":"value","v":"heart (levav - heart's desire)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"heart (self)","to":275423,"res":"span"},{"n":105,"l":"bearer","k":"pair","v":"the king","to":275423,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"none","res":"none"},{"n":107,"l":"target","k":"pair","v":"none","res":"none"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"none","res":"none"},{"n":116,"l":"locus","k":"value","v":"internal:seat"},{"n":114,"l":"discovery","k":"note","v":"'May he grant you your HEART'S (levav) desire' — the inmost longing God is asked to fulfil; levav as the seat of desire, the king's deepest wish laid before God for granting"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "275427": {"gloss":"joy v5","dims":[{"n":101,"l":"sense","k":"value","v":"shout for joy (ranan)"},{"n":102,"l":"type","k":"value","v":"action"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"the congregation ('we')","to":275427,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"shout for joy"},{"n":107,"l":"target","k":"pair","v":"over your salvation","from":275427,"to":275428,"res":"span"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"none","res":"none"},{"n":116,"l":"locus","k":"value","v":"internal:ib-state"},{"n":114,"l":"discovery","k":"note","v":"'May WE SHOUT FOR JOY (ranan) over your salvation' — the anticipated corporate exultation; ranan = the ringing cry of joy, the people's shared gladness at the king's deliverance"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "275428": {"gloss":"salvation v5","dims":[{"n":101,"l":"sense","k":"value","v":"salvation (yeshuah)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"the king (his salvation)","to":275428,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"none","res":"none"},{"n":107,"l":"target","k":"pair","v":"none","res":"none"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"the joy is over it","from":275428,"to":275427,"res":"span"},{"n":116,"l":"locus","k":"value","v":"external:god"},{"n":114,"l":"discovery","k":"note","v":"'over your SALVATION (yeshuah)' — the deliverance that occasions the shout; first of the psalm's saturating salvation-words (yeshuah/yasha/yesha), the king's victory as God's gift"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "275438": {"gloss":"know v6","dims":[{"n":101,"l":"sense","k":"value","v":"know (yada)"},{"n":102,"l":"type","k":"value","v":"action"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"the psalmist ('I')","to":275438,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"know"},{"n":107,"l":"target","k":"pair","v":"that the LORD saves his anointed","from":275438,"to":275441,"res":"span"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"none","res":"none"},{"n":116,"l":"locus","k":"value","v":"internal:ib-state"},{"n":114,"l":"discovery","k":"note","v":"'Now I KNOW (yada) that the LORD saves his anointed' — the pivot from petition to assurance; yada = settled inner conviction, the confident knowledge on which the second half turns"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "275441": {"gloss":"saves v6","dims":[{"n":101,"l":"sense","k":"value","v":"save (yasha)"},{"n":102,"l":"type","k":"value","v":"action"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"the LORD","to":275441,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"save"},{"n":107,"l":"target","k":"pair","v":"his anointed","to":275441,"res":"inferred"},{"n":108,"l":"manner","k":"pair","v":"with the saving might of his right hand","from":275441,"to":275448,"res":"span"},{"n":112,"l":"coupling","k":"pair","v":"the object of 'I know'","from":275441,"to":275438,"res":"span"},{"n":116,"l":"locus","k":"value","v":"external:god"},{"n":114,"l":"discovery","k":"note","v":"'the LORD SAVES (yasha) his anointed' — the content of the assurance; yasha as God's characteristic act toward his messiah/king, answered from his holy heaven"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "275448": {"gloss":"saving v6","dims":[{"n":101,"l":"sense","k":"value","v":"saving might (yesha)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"God (his right hand)","to":275448,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"none","res":"none"},{"n":107,"l":"target","k":"pair","v":"none","res":"none"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"the might by which he saves","from":275448,"to":275441,"res":"span"},{"n":116,"l":"locus","k":"value","v":"external:god"},{"n":114,"l":"discovery","k":"note","v":"'the SAVING (yesha) might of his right hand' — salvation as power; yesha here concrete, the mighty deeds of God's right hand that effect the anointed's rescue"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "275456": {"gloss":"trust/invoke v7","dims":[{"n":101,"l":"sense","k":"value","v":"invoke / call to remembrance (zakar - 'we will remember the name')"},{"n":102,"l":"type","k":"value","v":"action"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"the congregation ('we')","to":275456,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"invoke / call to remembrance"},{"n":107,"l":"target","k":"pair","v":"the name of the LORD our God","to":275456,"res":"inferred"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"none","res":"none"},{"n":116,"l":"locus","k":"value","v":"external:god"},{"n":114,"l":"discovery","k":"note","v":"'Some trust in chariots... but WE INVOKE (zakar) the name of the LORD' — the Hebrew is nazkir, 'we will remember/call upon', the same root as v3's zakar turned manward: our confidence is the invoked name, not military might; the trust-object contrast at the psalm's heart"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "275467": {"gloss":"save v9","dims":[{"n":101,"l":"sense","k":"value","v":"save (yasha)"},{"n":102,"l":"type","k":"value","v":"action"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"the LORD (appealed to)","to":275467,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"save"},{"n":107,"l":"target","k":"pair","v":"the king","to":275467,"res":"inferred"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"paired with the answering call","from":275467,"to":275472,"res":"span"},{"n":116,"l":"locus","k":"value","v":"external:god"},{"n":114,"l":"discovery","k":"note","v":"'O LORD, SAVE (yasha) the king!' — the closing plea gathering the psalm's salvation-thread into one cry; yasha now imperative, the people's direct appeal for the anointed"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "275472": {"gloss":"call v9","dims":[{"n":101,"l":"sense","k":"value","v":"call (qara)"},{"n":102,"l":"type","k":"value","v":"action"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"the congregation ('when we call')","to":275472,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"call"},{"n":107,"l":"target","k":"pair","v":"the LORD","to":275472,"res":"inferred"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"paired with 'save the king'","from":275472,"to":275467,"res":"span"},{"n":116,"l":"locus","k":"value","v":"external:god"},{"n":114,"l":"discovery","k":"note","v":"'May he answer us when we CALL (qara)' — the closing note of dependence; qara = the appeal that expects response, the people's confidence that the invoked name (v7) answers"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "275405": {"gloss":"name v1","dims":[{"n":101,"l":"sense","k":"value","v":"name (shem - of the God of Jacob)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":114,"l":"discovery","k":"note","v":"v1: 'the NAME (shem) of the God of Jacob protect you' - the divine name invoked as protection; shem = God's revealed character as a stronghold, the opening that the trust-contrast of v7 will develop (the name vs chariots)"},{"n":115,"l":"role","k":"value","v":"standalone"}]},
    "275412": {"gloss":"sanctuary v2","dims":[{"n":101,"l":"sense","k":"value","v":"sanctuary / holy place (qodesh)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":114,"l":"discovery","k":"note","v":"v2: 'help from the SANCTUARY (qodesh) and support from Zion' - the source of the aid sought; God's dwelling as the wellspring of help, the place from which rescue comes to the king"},{"n":115,"l":"role","k":"value","v":"standalone"}]},
    "275461": {"gloss":"collapse v8","dims":[{"n":101,"l":"sense","k":"value","v":"collapse / bow down (kara)"},{"n":102,"l":"type","k":"value","v":"action"},{"n":114,"l":"discovery","k":"note","v":"v8: 'They COLLAPSE (kara) and fall, but we rise and stand upright' - the outcome-contrast of the two trusts; those trusting chariots buckle, those invoking the name stand; the fall of the self-reliant vs the standing of the God-reliant"},{"n":115,"l":"role","k":"value","v":"standalone"}]}
