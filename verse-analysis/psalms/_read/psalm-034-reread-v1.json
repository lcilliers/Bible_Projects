    "277150": {"gloss":"fear v11","dims":[{"n":101,"l":"sense","k":"value","v":"fear (yirah - I will teach you the fear of the LORD)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"the children (taught the fear)","to":277150,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"none","res":"none"},{"n":107,"l":"target","k":"pair","v":"none","res":"none"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"none","res":"none"},{"n":116,"l":"locus","k":"value","v":"external:god"},{"n":114,"l":"discovery","k":"note","v":"'Come, O children... I will teach you the FEAR (yirah) of the LORD' — the fear as a teachable discipline; yirah (fourth of four) the reverence the psalmist sets out to instruct, the theme of the wisdom-section (v11-14)"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "277154": {"gloss":"desires v12","dims":[{"n":101,"l":"sense","k":"value","v":"desire / delight in (chaphets - desires life)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"the man who desires life","to":277154,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"none","res":"none"},{"n":107,"l":"target","k":"pair","v":"life","to":277154,"res":"inferred"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"paired with loving many days","from":277154,"to":277156,"res":"span"},{"n":116,"l":"locus","k":"value","v":"internal:ib-state"},{"n":114,"l":"discovery","k":"note","v":"'What man is there who DESIRES (chaphets) life?' — the longing for life the fear of God answers; chaphets (as Ps16:3) the desire that, rightly pursued, is met by guarding the tongue and doing good"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "277156": {"gloss":"loves v12","dims":[{"n":101,"l":"sense","k":"value","v":"love (aheb - loves many days)"},{"n":102,"l":"type","k":"value","v":"action"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"the man who desires life","to":277156,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"love"},{"n":107,"l":"target","k":"pair","v":"many days (to see good)","from":277156,"to":277159,"res":"span"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"paired with desiring life","from":277156,"to":277154,"res":"span"},{"n":116,"l":"locus","k":"value","v":"internal:ib-state"},{"n":114,"l":"discovery","k":"note","v":"'and LOVES (aheb) many days, that he may see good' — the love of a long good life; aheb (recurs Ps33:5) here the desire for days that see good, the goal the fear of the LORD secures"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "277159": {"gloss":"good v12","dims":[{"n":101,"l":"sense","k":"value","v":"good (tov - that he may see good)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"the man (who would see good)","to":277159,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"none","res":"none"},{"n":107,"l":"target","k":"pair","v":"none","res":"none"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"the loved days are to see it","from":277159,"to":277156,"res":"span"},{"n":116,"l":"locus","k":"value","v":"internal:ib-state"},{"n":114,"l":"discovery","k":"note","v":"'that he may see GOOD (tov)' — the good life aims at; tov (third of five) the good the God-fearer would enjoy, secured by righteous conduct"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "277163": {"gloss":"evil v13","dims":[{"n":101,"l":"sense","k":"value","v":"evil (ra - keep tongue from evil)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"the God-fearer (guards against it)","to":277163,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"none","res":"none"},{"n":107,"l":"target","k":"pair","v":"none","res":"none"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"paired with deceit","from":277163,"to":277167,"res":"span"},{"n":113,"l":"prohibition","k":"flag","v":"guarded-against ('Keep your tongue from EVIL')"},{"n":116,"l":"locus","k":"value","v":"internal:ib-state"},{"n":114,"l":"discovery","k":"note","v":"'Keep your tongue from EVIL (ra) and your lips from deceit' — the fear of God begins with guarded speech; ra (first of the ra-cluster, v13,14,16) the evil the tongue must shun"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "277167": {"gloss":"deceit v13","dims":[{"n":101,"l":"sense","k":"value","v":"deceit (mirmah)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"the God-fearer (lips guarded from it)","to":277167,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"none","res":"none"},{"n":107,"l":"target","k":"pair","v":"none","res":"none"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"paired with evil","from":277167,"to":277163,"res":"span"},{"n":113,"l":"prohibition","k":"flag","v":"guarded-against ('lips from speaking DECEIT')"},{"n":116,"l":"locus","k":"value","v":"internal:ib-state"},{"n":114,"l":"discovery","k":"note","v":"'and your lips from speaking DECEIT (mirmah)' — truthful speech as part of the fear; mirmah (recurs Ps24:4) the guile the God-fearer's lips avoid"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "277170": {"gloss":"evil v14","dims":[{"n":101,"l":"sense","k":"value","v":"evil (ra - turn away from evil)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"the God-fearer (turns from it)","to":277170,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"none","res":"none"},{"n":107,"l":"target","k":"pair","v":"none","res":"none"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"paired with doing good","from":277170,"to":277172,"res":"span"},{"n":113,"l":"prohibition","k":"flag","v":"turned-from ('Turn away from EVIL')"},{"n":116,"l":"locus","k":"value","v":"internal:ib-state"},{"n":114,"l":"discovery","k":"note","v":"'Turn away from EVIL (ra) and do good' — the double command of the fear; ra (second of the cluster) the evil to be forsaken, matched by the positive doing of good"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "277172": {"gloss":"good v14","dims":[{"n":101,"l":"sense","k":"value","v":"good (tov - do good)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"the God-fearer","to":277172,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"do (good)","to":277172,"res":"inferred"},{"n":107,"l":"target","k":"pair","v":"none","res":"none"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"paired with turning from evil","from":277172,"to":277170,"res":"span"},{"n":116,"l":"locus","k":"value","v":"internal:ib-state"},{"n":114,"l":"discovery","k":"note","v":"'and DO GOOD (tov)' — the active good matching the turn from evil; tov (fourth of five) the good deeds of the God-fearer, the positive half of the command"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "277174": {"gloss":"peace v14","dims":[{"n":101,"l":"sense","k":"value","v":"peace (shalom - seek peace and pursue it)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"the God-fearer (seeks it)","to":277174,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"seek and pursue","to":277174,"res":"inferred"},{"n":107,"l":"target","k":"pair","v":"none","res":"none"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"none","res":"none"},{"n":116,"l":"locus","k":"value","v":"internal:ib-state"},{"n":114,"l":"discovery","k":"note","v":"'SEEK PEACE (shalom) and pursue it' — peace as an active quest; shalom (recurs Ps29:11) the well-being the God-fearer not merely wants but chases after, the climax of the wisdom-instruction"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "277179": {"gloss":"righteous v15","dims":[{"n":101,"l":"sense","k":"value","v":"righteous (tsaddiq)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"the righteous (God's eyes toward them)","to":277179,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"none","res":"none"},{"n":107,"l":"target","k":"pair","v":"none","res":"none"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"none","res":"none"},{"n":116,"l":"locus","k":"value","v":"external:god"},{"n":114,"l":"discovery","k":"note","v":"'The eyes of the LORD are toward the RIGHTEOUS (tsaddiq)' — God's attentive regard; tsaddiq (first of four, v15,19,21) the righteous on whom God's eyes and ears rest, in contrast to his face against evildoers (v16)"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "277186": {"gloss":"evil v16","dims":[{"n":101,"l":"sense","k":"value","v":"evil (ra - those who do evil)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"the evildoers","to":277186,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"none","res":"none"},{"n":107,"l":"target","k":"pair","v":"none","res":"none"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"none","res":"none"},{"n":116,"l":"locus","k":"value","v":"external:person"},{"n":114,"l":"discovery","k":"note","v":"'The face of the LORD is against those who do EVIL (ra)' — God's opposition to the wicked; ra (third of the cluster) the evildoers whose memory God cuts off, the dark counterpart to his eyes toward the righteous"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "277192": {"gloss":"cry for help v17","dims":[{"n":101,"l":"sense","k":"value","v":"cry for help (tsaaq)"},{"n":102,"l":"type","k":"value","v":"action"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"the righteous","to":277192,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"cry for help"},{"n":107,"l":"target","k":"pair","v":"the LORD","to":277192,"res":"inferred"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"none","res":"none"},{"n":116,"l":"locus","k":"value","v":"external:god"},{"n":114,"l":"discovery","k":"note","v":"'When the righteous CRY FOR HELP (tsaaq), the LORD hears and delivers' — the answered cry of the just; tsaaq (a cry like zaaq, Ps22:5) the appeal God hears, delivering from all troubles"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "277202": {"gloss":"brokenhearted v18","dims":[{"n":101,"l":"sense","k":"value","v":"broken (shabar - the brokenhearted)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"heart (self, broken)","to":277202,"res":"inferred"},{"n":105,"l":"bearer","k":"pair","v":"the brokenhearted","to":277202,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"none","res":"none"},{"n":107,"l":"target","k":"pair","v":"the LORD is near to them","to":277202,"res":"inferred"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"paired with the crushed in spirit","from":277202,"to":277204,"res":"span"},{"n":116,"l":"locus","k":"value","v":"internal:ib-state"},{"n":114,"l":"discovery","k":"note","v":"'The LORD is near to the BROKENHEARTED (shabar - broken of heart)' — God's nearness to the shattered; shabar (first of two, v18 heart / v20 bones) the broken heart to which God draws close (contrast v20's unbroken bones)"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "277203": {"gloss":"saves v18","dims":[{"n":101,"l":"sense","k":"value","v":"save (yasha - saves the crushed)"},{"n":102,"l":"type","k":"value","v":"action"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"the LORD","to":277203,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"save"},{"n":107,"l":"target","k":"pair","v":"the crushed in spirit","from":277203,"to":277204,"res":"span"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"none","res":"none"},{"n":116,"l":"locus","k":"value","v":"external:god"},{"n":114,"l":"discovery","k":"note","v":"'and SAVES (yasha) the crushed in spirit' — God's rescue of the shattered; yasha (recurs v6) the salvation reserved for the humble and broken, near to those low in spirit"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "277204": {"gloss":"crushed v18","dims":[{"n":101,"l":"sense","k":"value","v":"crushed / contrite (daka - of spirit)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"spirit (self, crushed)","to":277204,"res":"inferred"},{"n":105,"l":"bearer","k":"pair","v":"the crushed in spirit","to":277204,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"none","res":"none"},{"n":107,"l":"target","k":"pair","v":"saved by God","from":277204,"to":277203,"res":"span"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"paired with the brokenhearted","from":277204,"to":277202,"res":"span"},{"n":116,"l":"locus","k":"value","v":"internal:ib-state"},{"n":114,"l":"discovery","k":"note","v":"'saves the CRUSHED (daka) in spirit' — the contrite spirit God rescues; daka = crushed/contrite, the lowly inner state (with the broken heart) that draws God's nearness and salvation"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "277207": {"gloss":"afflictions v19","dims":[{"n":101,"l":"sense","k":"value","v":"afflictions / evils (ra - many afflictions of the righteous)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"the righteous","from":277207,"to":277208,"res":"span"},{"n":106,"l":"operation","k":"event","v":"none","res":"none"},{"n":107,"l":"target","k":"pair","v":"none","res":"none"},{"n":108,"l":"manner","k":"pair","v":"many","to":277207,"res":"inferred"},{"n":112,"l":"coupling","k":"pair","v":"of the righteous","from":277207,"to":277208,"res":"span"},{"n":116,"l":"locus","k":"value","v":"internal:ib-state"},{"n":114,"l":"discovery","k":"note","v":"'Many are the AFFLICTIONS (ra) of the righteous, but the LORD delivers him' — the sufferings of the just, all overcome; ra here in its sense of calamity/affliction (fourth of the cluster), many but not final, for God delivers from all"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "277208": {"gloss":"righteous v19","dims":[{"n":101,"l":"sense","k":"value","v":"righteous (tsaddiq)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"the righteous (delivered)","to":277208,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"none","res":"none"},{"n":107,"l":"target","k":"pair","v":"none","res":"none"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"whose afflictions are many","from":277208,"to":277207,"res":"span"},{"n":116,"l":"locus","k":"value","v":"internal:ib-state"},{"n":114,"l":"discovery","k":"note","v":"'the RIGHTEOUS (tsaddiq)... the LORD delivers him out of them all' — the just delivered from every affliction; tsaddiq (second of four) the righteous whose many troubles God ends"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "277224": {"gloss":"broken v20","dims":[{"n":101,"l":"sense","k":"value","v":"break (shabar - not one bone broken, negated)"},{"n":102,"l":"type","k":"value","v":"action"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"the righteous (his bones)","to":277224,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"break (negated)"},{"n":107,"l":"target","k":"pair","v":"none","res":"none"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"none","res":"none"},{"n":113,"l":"prohibition","k":"flag","v":"negated ('not one of them is BROKEN')"},{"n":116,"l":"locus","k":"value","v":"internal:ib-state"},{"n":114,"l":"discovery","k":"note","v":"'He keeps all his bones; not one of them is BROKEN (shabar)' — the preservation of the righteous; shabar (second of two) here negated of the bones — the broken heart (v18) draws God near, yet not a bone is broken, the righteous kept whole (fulfilled in Christ, Jn19:36)"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "277225": {"gloss":"Affliction v21","dims":[{"n":101,"l":"sense","k":"value","v":"evil / affliction (ra - shall slay the wicked)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"the wicked (slain by their own evil)","to":277225,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"slay","to":277225,"res":"inferred"},{"n":107,"l":"target","k":"pair","v":"the wicked","from":277225,"to":277227,"res":"span"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"none","res":"none"},{"n":116,"l":"locus","k":"value","v":"internal:ib-state"},{"n":114,"l":"discovery","k":"note","v":"'AFFLICTION (ra) will slay the wicked' — evil recoiling on its doer; ra (fifth of the cluster) here the calamity that kills the wicked — the same word that afflicts the righteous (v19) destroys the wicked, opposite outcomes"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "277227": {"gloss":"wicked v21","dims":[{"n":101,"l":"sense","k":"value","v":"wicked (rasha)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"the wicked (slain)","to":277227,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"none","res":"none"},{"n":107,"l":"target","k":"pair","v":"none","res":"none"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"slain by affliction","from":277227,"to":277225,"res":"span"},{"n":116,"l":"locus","k":"value","v":"external:person"},{"n":114,"l":"discovery","k":"note","v":"'will slay the WICKED (rasha)' — the wicked destroyed by evil; rasha the object of the recoiling calamity, whose hatred of the righteous brings condemnation"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "277228": {"gloss":"hate v21","dims":[{"n":101,"l":"sense","k":"value","v":"hate (sane - those who hate the righteous)"},{"n":102,"l":"type","k":"value","v":"action"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"those who hate the righteous","to":277228,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"hate"},{"n":107,"l":"target","k":"pair","v":"the righteous","from":277228,"to":277229,"res":"span"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"paired with being condemned","from":277228,"to":277230,"res":"span"},{"n":116,"l":"locus","k":"value","v":"internal:ib-state"},{"n":114,"l":"discovery","k":"note","v":"'those who HATE (sane) the righteous will be condemned' — the haters judged; sane (recurs Ps25:19) the hatred of the just that brings guilt, condemnation the fate of the righteous-haters"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "277229": {"gloss":"righteous v21","dims":[{"n":101,"l":"sense","k":"value","v":"righteous (tsaddiq - hated)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"the righteous (hated by the wicked)","to":277229,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"none","res":"none"},{"n":107,"l":"target","k":"pair","v":"none","res":"none"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"the target of hatred","from":277229,"to":277228,"res":"span"},{"n":116,"l":"locus","k":"value","v":"internal:ib-state"},{"n":114,"l":"discovery","k":"note","v":"'those who hate the RIGHTEOUS (tsaddiq)' — the just as object of hatred; tsaddiq (fourth of four) the righteous whose haters are condemned, God's care for them vindicated"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "277230": {"gloss":"condemned v21","dims":[{"n":101,"l":"sense","k":"value","v":"be condemned / held guilty (asham)"},{"n":102,"l":"type","k":"value","v":"action"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"the righteous-haters","from":277230,"to":277228,"res":"span"},{"n":106,"l":"operation","k":"event","v":"be condemned"},{"n":107,"l":"target","k":"pair","v":"none","res":"none"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"the fate of the haters","from":277230,"to":277228,"res":"span"},{"n":116,"l":"locus","k":"value","v":"internal:ib-state"},{"n":114,"l":"discovery","k":"note","v":"'will be CONDEMNED (asham)' — the guilt-verdict on the haters; asham (first of two, v21,22) = to be held guilty/desolate, the doom of those who hate the righteous"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "277232": {"gloss":"redeems v22","dims":[{"n":101,"l":"sense","k":"value","v":"redeem / ransom (padah)"},{"n":102,"l":"type","k":"value","v":"action"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"the LORD","to":277232,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"redeem"},{"n":107,"l":"target","k":"pair","v":"the life of his servants","from":277232,"to":277233,"res":"span"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"none","res":"none"},{"n":116,"l":"locus","k":"value","v":"external:god"},{"n":114,"l":"discovery","k":"note","v":"'The LORD REDEEMS (padah) the life of his servants' — the ransom of the faithful; padah (recurs Ps25,26,31) the redemption of the servants' life, the final assurance closing the acrostic"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "277233": {"gloss":"life v22","dims":[{"n":101,"l":"sense","k":"value","v":"soul / life (nefesh - of his servants)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"soul (self)","to":277233,"res":"span"},{"n":105,"l":"bearer","k":"pair","v":"his servants","to":277233,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"none","res":"none"},{"n":107,"l":"target","k":"pair","v":"redeemed by God","from":277233,"to":277232,"res":"span"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"none","res":"none"},{"n":116,"l":"locus","k":"value","v":"internal:seat"},{"n":114,"l":"discovery","k":"note","v":"'the LIFE (nefesh) of his servants' — the life God ransoms; nefesh (second of two, v2,22) the servants' life redeemed, none who take refuge condemned"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "277236": {"gloss":"take refuge v22","dims":[{"n":101,"l":"sense","k":"value","v":"take refuge (chasah)"},{"n":102,"l":"type","k":"value","v":"action"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"those who take refuge in God","to":277236,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"take refuge"},{"n":107,"l":"target","k":"pair","v":"God","to":277236,"res":"inferred"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"paired with not being condemned","from":277236,"to":277238,"res":"span"},{"n":116,"l":"locus","k":"value","v":"external:god"},{"n":114,"l":"discovery","k":"note","v":"'none of those who TAKE REFUGE (chasah) in him will be condemned' — the refuge-takers acquitted; chasah (second of two, v8,22) the sheltering that guarantees against condemnation, the acrostic's closing assurance"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
