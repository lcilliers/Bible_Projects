    "277140": {"gloss":"seek v10","dims":[{"n":101,"l":"sense","k":"value","v":"seek (darash)"},{"n":102,"l":"type","k":"value","v":"action"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"those who seek the LORD","to":277140,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"seek"},{"n":107,"l":"target","k":"pair","v":"the LORD","to":277140,"res":"inferred"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"lack no good thing","from":277140,"to":277144,"res":"span"},{"n":116,"l":"locus","k":"value","v":"external:god"},{"n":114,"l":"discovery","k":"note","v":"'those who SEEK (darash) the LORD lack no good thing' — the seekers provided for; darash (recurs v4) here the ongoing seeking, contrasted with the young lions who hunger — God's seekers never lack good"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
