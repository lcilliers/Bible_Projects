    "276310": {"gloss":"heart v8","dims":[{"n":101,"l":"sense","k":"value","v":"heart (lev - my heart says)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"heart (self)","to":276310,"res":"span"},{"n":105,"l":"bearer","k":"pair","v":"David","to":276310,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"say (respond to God)","to":276310,"res":"inferred"},{"n":107,"l":"target","k":"pair","v":"God ('your face I seek')","to":276310,"res":"inferred"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"none","res":"none"},{"n":116,"l":"locus","k":"value","v":"internal:seat"},{"n":114,"l":"discovery","k":"note","v":"'You have said, Seek my face. My HEART (lev) says, Your face, LORD, do I seek' — the heart answering God's call; the second station of the heart's journey — the seeking heart, echoing the divine invitation with its own longing"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "276315": {"gloss":"Hide v9","dims":[{"n":101,"l":"sense","k":"value","v":"hide (sathar - your face, negated plea)"},{"n":102,"l":"type","k":"value","v":"action"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"God (asked NOT to)","to":276315,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"hide face (deprecated)"},{"n":107,"l":"target","k":"pair","v":"David","to":276315,"res":"inferred"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"none","res":"none"},{"n":113,"l":"prohibition","k":"flag","v":"deprecated ('HIDE NOT your face from me')"},{"n":116,"l":"locus","k":"value","v":"external:god"},{"n":114,"l":"discovery","k":"note","v":"'HIDE (sathar) not your face from me' — the plea against divine withdrawal; sathar reversed from v5 — there God hid HIM protectively, here he begs God not to hide his FACE, the terror of abandonment"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "276319": {"gloss":"anger v9","dims":[{"n":101,"l":"sense","k":"value","v":"anger (aph - turn not away in anger)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"God's anger (aph)","to":276319,"res":"span"},{"n":105,"l":"bearer","k":"pair","v":"God","to":276319,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"none","res":"none"},{"n":107,"l":"target","k":"pair","v":"the servant (deprecated)","to":276319,"res":"inferred"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"none","res":"none"},{"n":113,"l":"prohibition","k":"flag","v":"deprecated ('turn not your servant away in ANGER')"},{"n":116,"l":"locus","k":"value","v":"external:god"},{"n":114,"l":"discovery","k":"note","v":"'Turn not your servant away in ANGER (aph)' — the fear of God's wrath toward oneself; aph (recurs Ps18,21 of wrath on enemies) here begged not to fall on the servant, the plea for continued favour"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "276322": {"gloss":"forsake v9","dims":[{"n":101,"l":"sense","k":"value","v":"forsake (azab, negated plea)"},{"n":102,"l":"type","k":"value","v":"action"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"God (asked NOT to)","to":276322,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"forsake (deprecated)"},{"n":107,"l":"target","k":"pair","v":"David","to":276322,"res":"inferred"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"paired with God his salvation","from":276322,"to":276325,"res":"span"},{"n":113,"l":"prohibition","k":"flag","v":"deprecated ('forsake me NOT, O God of my salvation')"},{"n":116,"l":"locus","k":"value","v":"external:god"},{"n":114,"l":"discovery","k":"note","v":"'Cast me not off; FORSAKE (azab) me not' — the dread of abandonment; azab (as Ps22:1) here begged against — the first of the forsaking-pair, answered by v10's parents-forsake-but-God-takes-in"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "276325": {"gloss":"salvation v9","dims":[{"n":101,"l":"sense","k":"value","v":"salvation (yesha - God of my salvation)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"David (God his salvation)","to":276325,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"none","res":"none"},{"n":107,"l":"target","k":"pair","v":"none","res":"none"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"paired with the plea not to forsake","from":276325,"to":276322,"res":"span"},{"n":116,"l":"locus","k":"value","v":"external:god"},{"n":114,"l":"discovery","k":"note","v":"'O God of my SALVATION (yesha)' — the title grounding the plea; yesha (recurs v1) — the God who is his salvation surely will not forsake, the appeal resting on God's saving character"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "306194": {"gloss":"forsaken v10","dims":[{"n":101,"l":"sense","k":"value","v":"forsake (azab - father and mother)"},{"n":102,"l":"type","k":"value","v":"action"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"father and mother","to":306194,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"forsake"},{"n":107,"l":"target","k":"pair","v":"David","to":306194,"res":"inferred"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"none","res":"none"},{"n":116,"l":"locus","k":"value","v":"external:person"},{"n":114,"l":"discovery","k":"note","v":"'For my father and mother have FORSAKEN (azab) me, but the LORD will take me in' — the forsaking contrast; azab (the same verb of v9) — even the closest human bonds may abandon, but God receives the forsaken, the deepest assurance of the psalm"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "276215": {"gloss":"will/soul v12","dims":[{"n":101,"l":"sense","k":"value","v":"soul / desire (nefesh - the will of my adversaries)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"the adversaries (their nefesh/desire)","to":276215,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"none","res":"none"},{"n":107,"l":"target","k":"pair","v":"David (not given to it)","to":276215,"res":"inferred"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"none","res":"none"},{"n":113,"l":"prohibition","k":"flag","v":"deprecated ('Give me NOT up to the will of my adversaries')"},{"n":116,"l":"locus","k":"value","v":"internal:ib-state"},{"n":114,"l":"discovery","k":"note","v":"'Give me not up to the WILL (nefesh) of my adversaries' — nefesh here as greedy desire/appetite; the sufferer begs not to be handed to the foes' craving, their nefesh set on his ruin"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "276217": {"gloss":"false v12","dims":[{"n":101,"l":"sense","k":"value","v":"falsehood / lie (sheqer - false witnesses)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"the false witnesses","to":276217,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"none","res":"none"},{"n":107,"l":"target","k":"pair","v":"David","to":276217,"res":"inferred"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"paired with breathing violence","from":276217,"to":276221,"res":"span"},{"n":116,"l":"locus","k":"value","v":"internal:ib-state"},{"n":114,"l":"discovery","k":"note","v":"'FALSE (sheqer) witnesses have risen against me' — the lying accusers; sheqer = deliberate falsehood, the perjury that assails the innocent, breathing out violence"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "276221": {"gloss":"violence v12","dims":[{"n":101,"l":"sense","k":"value","v":"violence (chamas)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"the false witnesses","to":276221,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"breathe out","to":276221,"res":"inferred"},{"n":107,"l":"target","k":"pair","v":"David","to":276221,"res":"inferred"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"paired with false witness","from":276221,"to":276217,"res":"span"},{"n":116,"l":"locus","k":"value","v":"internal:ib-state"},{"n":114,"l":"discovery","k":"note","v":"'and they breathe out VIOLENCE (chamas)' — malice exhaled; chamas (recurs Ps25:19) the violence the false witnesses pant after, cruelty joined to perjury"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "276222": {"gloss":"believe v13","dims":[{"n":101,"l":"sense","k":"value","v":"believe / trust firmly (aman)"},{"n":102,"l":"type","k":"value","v":"action"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"David","to":276222,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"believe"},{"n":107,"l":"target","k":"pair","v":"that he shall see God's goodness","from":276222,"to":276224,"res":"span"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"none","res":"none"},{"n":116,"l":"locus","k":"value","v":"external:god"},{"n":114,"l":"discovery","k":"note","v":"'I BELIEVE (aman) that I shall look upon the goodness of the LORD in the land of the living' — faith holding to future good; aman = firm confidence, the belief that steadies the soul against the false witnesses, the psalm's turn back to hope"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "276224": {"gloss":"goodness v13","dims":[{"n":101,"l":"sense","k":"value","v":"goodness (tov - of the LORD)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"God (his goodness)","to":276224,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"none","res":"none"},{"n":107,"l":"target","k":"pair","v":"none","res":"none"},{"n":108,"l":"manner","k":"pair","v":"in the land of the living","to":276224,"res":"inferred"},{"n":112,"l":"coupling","k":"pair","v":"the object of belief","from":276224,"to":276222,"res":"span"},{"n":116,"l":"locus","k":"value","v":"external:god"},{"n":114,"l":"discovery","k":"note","v":"'the GOODNESS (tov) of the LORD in the land of the living' — the good the believing soul expects to see; tov (recurs Ps25) here the future vision of God's kindness, faith's certain hope"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "276229": {"gloss":"Wait(a) v14","dims":[{"n":101,"l":"sense","k":"value","v":"wait (qavah)"},{"n":102,"l":"type","k":"value","v":"action"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"the soul (self-address)","to":276229,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"wait"},{"n":107,"l":"target","k":"pair","v":"the LORD","to":276229,"res":"inferred"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"bookends with the second wait","from":276229,"to":276234,"res":"span"},{"n":116,"l":"locus","k":"value","v":"external:god"},{"n":114,"l":"discovery","k":"note","v":"'WAIT (qavah) for the LORD' — the self-exhortation to patient hope; qavah (recurs Ps25:3,5,21) opens the closing bracket, the disciplined expectation that frames the final verse"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "276231": {"gloss":"strong v14","dims":[{"n":101,"l":"sense","k":"value","v":"be strong (chazaq)"},{"n":102,"l":"type","k":"value","v":"action"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"the soul (self-address)","to":276231,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"be strong"},{"n":107,"l":"target","k":"pair","v":"none","res":"none"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"paired with the heart taking courage","from":276231,"to":276232,"res":"span"},{"n":116,"l":"locus","k":"value","v":"internal:ib-state"},{"n":114,"l":"discovery","k":"note","v":"'be STRONG (chazaq), and let your heart take courage' — the summons to inner strength; chazaq the fortitude the waiting soul is exhorted to, paired with the heart's courage"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "276232": {"gloss":"heart v14","dims":[{"n":101,"l":"sense","k":"value","v":"heart (lev - let your heart take courage)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"heart (self)","to":276232,"res":"span"},{"n":105,"l":"bearer","k":"pair","v":"the self (addressed)","to":276232,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"none","res":"none"},{"n":107,"l":"target","k":"pair","v":"none","res":"none"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"takes courage","from":276232,"to":276233,"res":"span"},{"n":116,"l":"locus","k":"value","v":"internal:seat"},{"n":114,"l":"discovery","k":"note","v":"'let your HEART (lev) take courage' — the heart's final station; the third and climactic station of the heart's journey (v3 unafraid -> v8 seeking -> v14 couraged), the heart summoned to strength in the waiting"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "276233": {"gloss":"take courage v14","dims":[{"n":101,"l":"sense","k":"value","v":"take courage / be strong (amets)"},{"n":102,"l":"type","k":"value","v":"action"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"the heart","from":276233,"to":276232,"res":"span"},{"n":106,"l":"operation","k":"event","v":"take courage"},{"n":107,"l":"target","k":"pair","v":"none","res":"none"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"of the heart","from":276233,"to":276232,"res":"span"},{"n":116,"l":"locus","k":"value","v":"internal:ib-state"},{"n":114,"l":"discovery","k":"note","v":"'let your heart TAKE COURAGE (amets)' — courage as the heart's response; amets the strengthening/emboldening, paired with chazaq, the resolve that waiting on God demands"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "276234": {"gloss":"wait(b) v14","dims":[{"n":101,"l":"sense","k":"value","v":"wait (qavah, repeated)"},{"n":102,"l":"type","k":"value","v":"action"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"the soul (self-address)","to":276234,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"wait"},{"n":107,"l":"target","k":"pair","v":"the LORD","to":276234,"res":"inferred"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"bookends with the first wait","from":276234,"to":276229,"res":"span"},{"n":116,"l":"locus","k":"value","v":"external:god"},{"n":114,"l":"discovery","k":"note","v":"'WAIT (qavah) for the LORD!' — the repeated close; qavah bookends v14, the doubled command sealing the psalm — patient waiting as the whole counsel drawn from light, salvation, and the seeking heart"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "276236": {"gloss":"evildoers v2","dims":[{"n":101,"l":"sense","k":"value","v":"evildoers / do evil (ra'a)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":114,"l":"discovery","k":"note","v":"v2: 'When EVILDOERS assail me to eat up my flesh... it is they who stumble and fall' - the assailants' assault turned back on themselves; the malice that comes to devour instead collapses, the confidence-half's demonstration that God's light leaves no ground for fear"},{"n":115,"l":"role","k":"value","v":"standalone"}]},
    "276264": {"gloss":"one-thing/dwell v4","dims":[{"n":101,"l":"sense","k":"value","v":"seek / the one thing asked (dwell in God's house, gaze on his beauty)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":114,"l":"discovery","k":"note","v":"v4: 'ONE THING have I asked of the LORD, that will I SEEK: that I may dwell in the house of the LORD all my days, to gaze upon the beauty (noam) of the LORD' - the psalm's centre and single desire; the whole inner life focused to one longing - unbroken communion, beholding God's beauty, the singular passion above all rescue"},{"n":115,"l":"role","k":"value","v":"standalone"}]}
  }
