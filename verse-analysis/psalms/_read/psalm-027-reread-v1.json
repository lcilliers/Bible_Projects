    "276251": {"gloss":"heart v3","dims":[{"n":101,"l":"sense","k":"value","v":"heart (lev - shall not fear)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"heart (self)","to":276251,"res":"span"},{"n":105,"l":"bearer","k":"pair","v":"David","to":276251,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"none","res":"none"},{"n":107,"l":"target","k":"pair","v":"none","res":"none"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"does not fear","from":276251,"to":276253,"res":"span"},{"n":116,"l":"locus","k":"value","v":"internal:seat"},{"n":114,"l":"discovery","k":"note","v":"'Though an army encamp, my HEART (lev) shall not fear' — the fearless heart; the first station of the heart's journey through the psalm (v3 unafraid -> v8 seeking -> v14 couraged)"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
