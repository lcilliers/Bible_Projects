    "276260": {"gloss":"confident v3","dims":[{"n":101,"l":"sense","k":"value","v":"be confident / trust (batach)"},{"n":102,"l":"type","k":"value","v":"action"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"David","to":276260,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"be confident"},{"n":107,"l":"target","k":"pair","v":"God (implied)","to":276260,"res":"inferred"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"paired with the unfearing heart","from":276260,"to":276253,"res":"span"},{"n":116,"l":"locus","k":"value","v":"external:god"},{"n":114,"l":"discovery","k":"note","v":"'yet I will be CONFIDENT (batach)' — positive assurance amid war; batach the settled trust that turns absence of fear into active confidence"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "276282": {"gloss":"trouble v5","dims":[{"n":101,"l":"sense","k":"value","v":"trouble / evil (ra - day of trouble)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"the day (of trouble)","to":276282,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"none","res":"none"},{"n":107,"l":"target","k":"pair","v":"none","res":"none"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"the time God hides him","from":276282,"to":276283,"res":"span"},{"n":116,"l":"locus","k":"value","v":"external:thing"},{"n":114,"l":"discovery","k":"note","v":"'he will hide me in his shelter in the day of TROUBLE (ra)' — the evil day from which God conceals him; ra here the calamity, the setting of God's protective hiding"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "276283": {"gloss":"conceal v5","dims":[{"n":101,"l":"sense","k":"value","v":"conceal / hide (sathar)"},{"n":102,"l":"type","k":"value","v":"action"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"God","to":276283,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"conceal"},{"n":107,"l":"target","k":"pair","v":"David","to":276283,"res":"inferred"},{"n":108,"l":"manner","k":"pair","v":"under the cover of his tent","to":276283,"res":"inferred"},{"n":112,"l":"coupling","k":"pair","v":"paired with lifting high","from":276283,"to":276286,"res":"span"},{"n":116,"l":"locus","k":"value","v":"external:god"},{"n":114,"l":"discovery","k":"note","v":"'he will CONCEAL (sathar) me under the cover of his tent' — God's protective hiding; sathar here the good hiding (contrast v9 'hide not your face') — God conceals the sufferer to keep him, then lifts him high"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "276286": {"gloss":"lift v5","dims":[{"n":101,"l":"sense","k":"value","v":"lift high (rum)"},{"n":102,"l":"type","k":"value","v":"action"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"God","to":276286,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"lift high"},{"n":107,"l":"target","k":"pair","v":"David (upon a rock)","to":276286,"res":"inferred"},{"n":108,"l":"manner","k":"pair","v":"upon a rock","to":276286,"res":"inferred"},{"n":112,"l":"coupling","k":"pair","v":"paired with concealing","from":276286,"to":276283,"res":"span"},{"n":116,"l":"locus","k":"value","v":"external:god"},{"n":114,"l":"discovery","k":"note","v":"'he will LIFT me HIGH (rum) upon a rock' — exaltation to safety; rum the raising above danger, the first of two (v5,v6) — God lifts him to the rock, then his head is lifted above enemies"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "276291": {"gloss":"lifted v6","dims":[{"n":101,"l":"sense","k":"value","v":"be lifted up (rum - my head)"},{"n":102,"l":"type","k":"value","v":"action"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"David (his head)","to":276291,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"be lifted up"},{"n":107,"l":"target","k":"pair","v":"above his enemies","to":276291,"res":"inferred"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"paired with joyful sacrifice","from":276291,"to":276298,"res":"span"},{"n":116,"l":"locus","k":"value","v":"internal:ib-state"},{"n":114,"l":"discovery","k":"note","v":"'my head shall be LIFTED UP (rum) above my enemies' — vindication and honour; rum (recurs v5) now the raised head of triumph, occasioning shouts of joy and song"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
