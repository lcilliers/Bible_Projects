    "276299": {"gloss":"make melody v6","dims":[{"n":101,"l":"sense","k":"value","v":"make melody / sing praise (zamar)"},{"n":102,"l":"type","k":"value","v":"action"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"David","to":276299,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"make melody"},{"n":107,"l":"target","k":"pair","v":"the LORD","to":276299,"res":"inferred"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"paired with singing","from":276299,"to":276298,"res":"span"},{"n":116,"l":"locus","k":"value","v":"external:god"},{"n":114,"l":"discovery","k":"note","v":"'I will MAKE MELODY (zamar) to the LORD' — the musical praise completing the joy; zamar paired with shir, the double song that answers deliverance"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
