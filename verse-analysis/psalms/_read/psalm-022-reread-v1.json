    "275654": {"gloss":"cry v2","dims":[{"n":101,"l":"sense","k":"value","v":"cry / call (qara)"},{"n":102,"l":"type","k":"value","v":"action"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"David","to":275654,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"cry"},{"n":107,"l":"target","k":"pair","v":"God","to":275654,"res":"inferred"},{"n":108,"l":"manner","k":"pair","v":"by day and night","to":275654,"res":"inferred"},{"n":112,"l":"coupling","k":"pair","v":"none","res":"none"},{"n":116,"l":"locus","k":"value","v":"external:god"},{"n":114,"l":"discovery","k":"note","v":"'I CRY (qara) by day, but you do not answer' — the unanswered prayer; qara here met with silence, 'no rest' by night, the trial of the God who seems not to hear"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "275752": {"gloss":"holy v3","dims":[{"n":101,"l":"sense","k":"value","v":"holy (qadosh)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"God","to":275752,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"none","res":"none"},{"n":107,"l":"target","k":"pair","v":"none","res":"none"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"enthroned on the praises","from":275752,"to":275754,"res":"span"},{"n":116,"l":"locus","k":"value","v":"external:god"},{"n":114,"l":"discovery","k":"note","v":"'Yet you are HOLY (qadosh), enthroned on the praises of Israel' — the turn to God's character amid the silence; qadosh = the holiness that grounds hope even when rescue tarries"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "275754": {"gloss":"praises v3","dims":[{"n":101,"l":"sense","k":"value","v":"praises (tehillah)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"Israel (their praises)","to":275754,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"none","res":"none"},{"n":107,"l":"target","k":"pair","v":"none","res":"none"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"God enthroned on them","from":275754,"to":275752,"res":"span"},{"n":116,"l":"locus","k":"value","v":"external:god"},{"n":114,"l":"discovery","k":"note","v":"'enthroned on the PRAISES (tehillah) of Israel' — God dwelling amid his people's worship; tehillah the throne-room of the Holy One (recurs v25 as the sufferer's own praise)"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "275769": {"gloss":"trusted(a) v4","dims":[{"n":101,"l":"sense","k":"value","v":"trust (batach)"},{"n":102,"l":"type","k":"value","v":"action"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"our fathers","to":275769,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"trust"},{"n":107,"l":"target","k":"pair","v":"God ('in you')","to":275769,"res":"inferred"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"repeated in the same verse","from":275769,"to":275770,"res":"span"},{"n":116,"l":"locus","k":"value","v":"external:god"},{"n":114,"l":"discovery","k":"note","v":"'In you our fathers TRUSTED (batach)' — the appeal to covenant history; batach opens the five-fold trust-thread (v4x2, v5, v9), the fathers' reliance that was vindicated 'and you delivered them'"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "275770": {"gloss":"trusted(b) v4","dims":[{"n":101,"l":"sense","k":"value","v":"trust (batach, emphatic repetition)"},{"n":102,"l":"type","k":"value","v":"action"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"our fathers","to":275770,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"trust"},{"n":107,"l":"target","k":"pair","v":"God","to":275770,"res":"inferred"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"emphatic doubling","from":275770,"to":275769,"res":"span"},{"n":116,"l":"locus","k":"value","v":"external:god"},{"n":114,"l":"discovery","k":"note","v":"'they TRUSTED (batach), and you delivered them' — the doubled verb underscoring the fathers' reliance; the emphatic repetition drives the argument: trust met deliverance, why not now?"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "275774": {"gloss":"cried v5","dims":[{"n":101,"l":"sense","k":"value","v":"cry out (zaaq)"},{"n":102,"l":"type","k":"value","v":"action"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"the fathers","to":275774,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"cry out"},{"n":107,"l":"target","k":"pair","v":"God","to":275774,"res":"inferred"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"paired with their trusting","from":275774,"to":275777,"res":"span"},{"n":116,"l":"locus","k":"value","v":"external:god"},{"n":114,"l":"discovery","k":"note","v":"'To you they CRIED (zaaq) and were rescued' — the fathers' urgent appeal answered; zaaq = the cry of distress that, joined to trust, brought rescue and no shame"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "275777": {"gloss":"trusted v5","dims":[{"n":101,"l":"sense","k":"value","v":"trust (batach)"},{"n":102,"l":"type","k":"value","v":"action"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"the fathers","to":275777,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"trust"},{"n":107,"l":"target","k":"pair","v":"God","to":275777,"res":"inferred"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"paired with being not shamed","from":275777,"to":275779,"res":"span"},{"n":116,"l":"locus","k":"value","v":"external:god"},{"n":114,"l":"discovery","k":"note","v":"'in you they TRUSTED (batach) and were not put to shame' — the third batach; trust vindicated by non-shame, the pattern the sufferer pleads to share"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "275779": {"gloss":"put to shame v5","dims":[{"n":101,"l":"sense","k":"value","v":"be put to shame (bosh, negated)"},{"n":102,"l":"type","k":"value","v":"action"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"the fathers (not shamed)","to":275779,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"be put to shame (negated)"},{"n":107,"l":"target","k":"pair","v":"none","res":"none"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"result of their trust","from":275779,"to":275777,"res":"span"},{"n":113,"l":"prohibition","k":"flag","v":"negated ('were NOT put to shame')"},{"n":116,"l":"locus","k":"value","v":"internal:ib-state"},{"n":114,"l":"discovery","k":"note","v":"'were NOT put to SHAME (bosh)' — the reward of trust; bosh negated = the vindication the fathers received, the disgrace the sufferer fears but hopes to escape"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "275784": {"gloss":"scorned v6","dims":[{"n":101,"l":"sense","k":"value","v":"scorn / reproach (cherpah)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"David (object of scorn)","to":275784,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"none","res":"none"},{"n":107,"l":"target","k":"pair","v":"none","res":"none"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"paired with being despised","from":275784,"to":275786,"res":"span"},{"n":116,"l":"locus","k":"value","v":"internal:ib-state"},{"n":114,"l":"discovery","k":"note","v":"'I am a worm and not a man, SCORNED (cherpah) by mankind' — self-abasement under contempt; cherpah = the reproach heaped on him, the sufferer reduced to a worm in others' eyes"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "275786": {"gloss":"despised v6","dims":[{"n":101,"l":"sense","k":"value","v":"despise (bazah)"},{"n":102,"l":"type","k":"value","v":"action"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"the people","to":275786,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"despise"},{"n":107,"l":"target","k":"pair","v":"David","to":275786,"res":"inferred"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"paired with scorn","from":275786,"to":275784,"res":"span"},{"n":116,"l":"locus","k":"value","v":"external:person"},{"n":114,"l":"discovery","k":"note","v":"'DESPISED (bazah) by the people' — human contempt for the sufferer; bazah here of man toward David — deliberately reversed at v24 where God has NOT despised (bazah) the afflicted"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "306156": {"gloss":"mock v7","dims":[{"n":101,"l":"sense","k":"value","v":"mock / deride (laag)"},{"n":102,"l":"type","k":"value","v":"action"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"all who see him","to":306156,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"mock"},{"n":107,"l":"target","k":"pair","v":"David","to":306156,"res":"inferred"},{"n":108,"l":"manner","k":"pair","v":"wagging heads, making mouths","to":306156,"res":"inferred"},{"n":112,"l":"coupling","k":"pair","v":"none","res":"none"},{"n":116,"l":"locus","k":"value","v":"external:person"},{"n":114,"l":"discovery","k":"note","v":"'All who see me MOCK (laag) me' — derision expressed in gesture (wagging heads, gaping mouths); laag = the scornful mockery that taunts his faith (v8)"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "275792": {"gloss":"delights v8","dims":[{"n":101,"l":"sense","k":"value","v":"delight in (chaphets)"},{"n":102,"l":"type","k":"value","v":"action"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"God (as the mockers quote)","to":275792,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"delight in"},{"n":107,"l":"target","k":"pair","v":"David","to":275792,"res":"inferred"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"none","res":"none"},{"n":116,"l":"locus","k":"value","v":"external:god"},{"n":114,"l":"discovery","k":"note","v":"'let him deliver him... for he DELIGHTS (chaphets) in him' — the mockers weaponise his faith; chaphets on their lips is a taunt (does God really delight in him?), the same word that was the ground of rescue in Ps18:19"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "275799": {"gloss":"trust v9","dims":[{"n":101,"l":"sense","k":"value","v":"make trust (batach, hiphil)"},{"n":102,"l":"type","k":"value","v":"action"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"God","to":275799,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"make trust"},{"n":107,"l":"target","k":"pair","v":"David (from the breast)","to":275799,"res":"inferred"},{"n":108,"l":"manner","k":"pair","v":"at my mother's breasts","to":275799,"res":"inferred"},{"n":112,"l":"coupling","k":"pair","v":"none","res":"none"},{"n":116,"l":"locus","k":"value","v":"external:god"},{"n":114,"l":"discovery","k":"note","v":"'you made me TRUST (batach) you at my mother's breasts' — trust as God's own gift from infancy; the fifth batach, now lifelong dependence woven in from birth, the ground of the appeal 'be not far'"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "275597": {"gloss":"help v11","dims":[{"n":101,"l":"sense","k":"value","v":"help (azar - none to help)"},{"n":102,"l":"type","k":"value","v":"action"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"none (there is none)","res":"none"},{"n":106,"l":"operation","k":"event","v":"help (absent)"},{"n":107,"l":"target","k":"pair","v":"David","to":275597,"res":"inferred"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"none","res":"none"},{"n":113,"l":"prohibition","k":"flag","v":"absent ('there is none to help')"},{"n":116,"l":"locus","k":"value","v":"external:person"},{"n":114,"l":"discovery","k":"note","v":"'trouble is near, and there is none to HELP (azar)' — utter isolation; azar absent, the sufferer's aloneness that makes God his only recourse ('O you my help', v19)"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "275610": {"gloss":"heart v14","dims":[{"n":101,"l":"sense","k":"value","v":"heart (lev - like wax, melted)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"heart (self)","to":275610,"res":"span"},{"n":105,"l":"bearer","k":"pair","v":"David","to":275610,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"none","res":"none"},{"n":107,"l":"target","k":"pair","v":"none","res":"none"},{"n":108,"l":"manner","k":"pair","v":"melted within his breast","to":275610,"res":"inferred"},{"n":112,"l":"coupling","k":"pair","v":"none","res":"none"},{"n":116,"l":"locus","k":"value","v":"internal:seat"},{"n":114,"l":"discovery","k":"note","v":"'my HEART (lev) is like wax; it is melted within me' — courage utterly dissolved; the lev in extremity, the seat of strength liquefied by terror (contrast v26 'may your hearts live')"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "275663": {"gloss":"soul v20","dims":[{"n":101,"l":"sense","k":"value","v":"soul / life (nefesh)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"soul (self)","to":275663,"res":"span"},{"n":105,"l":"bearer","k":"pair","v":"David","to":275663,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"none","res":"none"},{"n":107,"l":"target","k":"pair","v":"delivered from the sword","to":275663,"res":"inferred"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"none","res":"none"},{"n":116,"l":"locus","k":"value","v":"internal:seat"},{"n":114,"l":"discovery","k":"note","v":"'Deliver my SOUL (nefesh) from the sword, my precious life from the dog' — the life-self imperilled; nefesh = the whole living person the sufferer begs God to rescue from death"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "306168": {"gloss":"Save v21","dims":[{"n":101,"l":"sense","k":"value","v":"save (yasha)"},{"n":102,"l":"type","k":"value","v":"action"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"God (appealed to)","to":306168,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"save"},{"n":107,"l":"target","k":"pair","v":"David","to":306168,"res":"inferred"},{"n":108,"l":"manner","k":"pair","v":"from the lion's mouth","to":306168,"res":"inferred"},{"n":112,"l":"coupling","k":"pair","v":"none","res":"none"},{"n":116,"l":"locus","k":"value","v":"external:god"},{"n":114,"l":"discovery","k":"note","v":"'SAVE (yasha) me from the mouth of the lion!' — the climactic plea of the lament; yasha the last cry before the abrupt turn to praise ('you have rescued me'), the hinge of the psalm"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "275677": {"gloss":"praise v22","dims":[{"n":101,"l":"sense","k":"value","v":"praise (halal)"},{"n":102,"l":"type","k":"value","v":"action"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"David","to":275677,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"praise"},{"n":107,"l":"target","k":"pair","v":"God","to":275677,"res":"inferred"},{"n":108,"l":"manner","k":"pair","v":"in the congregation","to":275677,"res":"inferred"},{"n":112,"l":"coupling","k":"pair","v":"none","res":"none"},{"n":116,"l":"locus","k":"value","v":"external:god"},{"n":114,"l":"discovery","k":"note","v":"'I will PRAISE (halal) you in the midst of the congregation' — the vow that opens the praise-half; halal the public celebration, the forsaken now become the herald of God's deeds"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "275679": {"gloss":"fear v23","dims":[{"n":101,"l":"sense","k":"value","v":"fear (yare - you who fear the LORD)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"the God-fearers","to":275679,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"none","res":"none"},{"n":107,"l":"target","k":"pair","v":"none","res":"none"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"summoned to praise","from":275679,"to":275681,"res":"span"},{"n":116,"l":"locus","k":"value","v":"external:god"},{"n":114,"l":"discovery","k":"note","v":"'You who FEAR (yare) the LORD, praise him!' — the God-fearers called to join; yare the reverent congregation summoned to the sufferer's thanksgiving"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "275681": {"gloss":"praise v23","dims":[{"n":101,"l":"sense","k":"value","v":"praise (halal, imperative)"},{"n":102,"l":"type","k":"value","v":"action"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"the God-fearers","from":275681,"to":275679,"res":"span"},{"n":106,"l":"operation","k":"event","v":"praise"},{"n":107,"l":"target","k":"pair","v":"God","to":275681,"res":"inferred"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"paired with glorify","from":275681,"to":275685,"res":"span"},{"n":116,"l":"locus","k":"value","v":"external:god"},{"n":114,"l":"discovery","k":"note","v":"'PRAISE (halal) him!' — the imperative call to the congregation; halal joined with kabed (glorify) and awe, the threefold summons of v23"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "275685": {"gloss":"glorify v23","dims":[{"n":101,"l":"sense","k":"value","v":"glorify / honour (kabed)"},{"n":102,"l":"type","k":"value","v":"action"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"the offspring of Jacob","to":275685,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"glorify"},{"n":107,"l":"target","k":"pair","v":"God","to":275685,"res":"inferred"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"paired with praise","from":275685,"to":275681,"res":"span"},{"n":116,"l":"locus","k":"value","v":"external:god"},{"n":114,"l":"discovery","k":"note","v":"'all you offspring of Jacob, GLORIFY (kabed) him' — honour rendered to God; kabed = to give weight/glory, the congregation's homage to the God who heard the afflicted"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "275693": {"gloss":"despised v24","dims":[{"n":101,"l":"sense","k":"value","v":"despise (bazah, negated)"},{"n":102,"l":"type","k":"value","v":"action"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"God","to":275693,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"despise (negated)"},{"n":107,"l":"target","k":"pair","v":"the affliction of the afflicted","from":275693,"to":275696,"res":"span"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"paired with abhorred","from":275693,"to":275695,"res":"span"},{"n":113,"l":"prohibition","k":"flag","v":"negated ('has NOT despised')"},{"n":116,"l":"locus","k":"value","v":"external:god"},{"n":114,"l":"discovery","k":"note","v":"'he has NOT DESPISED (bazah) the affliction of the afflicted' — the great reversal: man despised (bazah) the worm (v6), but God does not despise the sufferer; the same verb overturned, the theological heart of the psalm"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "275695": {"gloss":"abhorred v24","dims":[{"n":101,"l":"sense","k":"value","v":"abhor / detest (shaqats, negated)"},{"n":102,"l":"type","k":"value","v":"action"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"God","to":275695,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"abhor (negated)"},{"n":107,"l":"target","k":"pair","v":"the affliction","from":275695,"to":275696,"res":"span"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"paired with not despised","from":275695,"to":275693,"res":"span"},{"n":113,"l":"prohibition","k":"flag","v":"negated ('nor ABHORRED')"},{"n":116,"l":"locus","k":"value","v":"external:god"},{"n":114,"l":"discovery","k":"note","v":"'nor ABHORRED (shaqats) the affliction' — God's non-revulsion at suffering; shaqats negated, God does not turn away in disgust from the afflicted one, unlike the mocking crowd"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "275696": {"gloss":"affliction v24","dims":[{"n":101,"l":"sense","k":"value","v":"affliction (enuth)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"the afflicted one","from":275696,"to":275697,"res":"span"},{"n":106,"l":"operation","k":"event","v":"none","res":"none"},{"n":107,"l":"target","k":"pair","v":"none","res":"none"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"God has not despised it","from":275696,"to":275693,"res":"span"},{"n":116,"l":"locus","k":"value","v":"internal:ib-state"},{"n":114,"l":"discovery","k":"note","v":"the AFFLICTION (enuth) of the afflicted — the suffering God regards; enuth = the low estate of the oppressed, the very thing God does not scorn but heeds"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "275697": {"gloss":"afflicted v24","dims":[{"n":101,"l":"sense","k":"value","v":"afflicted (ani)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"the sufferer","to":275697,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"none","res":"none"},{"n":107,"l":"target","k":"pair","v":"none","res":"none"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"whose affliction God heeds","from":275697,"to":275696,"res":"span"},{"n":116,"l":"locus","k":"value","v":"internal:ib-state"},{"n":114,"l":"discovery","k":"note","v":"the AFFLICTED (ani) one — the lowly sufferer; ani (as Ps18:27) the humble God saves, here the one whose cry God has heard"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "275699": {"gloss":"hidden v24","dims":[{"n":101,"l":"sense","k":"value","v":"hide (sathar - his face, negated)"},{"n":102,"l":"type","k":"value","v":"action"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"God","to":275699,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"hide his face (negated)"},{"n":107,"l":"target","k":"pair","v":"the afflicted","to":275699,"res":"inferred"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"none","res":"none"},{"n":113,"l":"prohibition","k":"flag","v":"negated ('has NOT hidden his face')"},{"n":116,"l":"locus","k":"value","v":"external:god"},{"n":114,"l":"discovery","k":"note","v":"'has NOT HIDDEN (sathar) his face from him, but heard' — the answered cry; sathar negated overturns the felt forsakenness of v1 — the God who seemed far has not hidden his face after all"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "275705": {"gloss":"praise v25","dims":[{"n":101,"l":"sense","k":"value","v":"praise (tehillah - my praise)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"David","to":275705,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"none","res":"none"},{"n":107,"l":"target","k":"pair","v":"God ('from you comes my praise')","to":275705,"res":"inferred"},{"n":108,"l":"manner","k":"pair","v":"in the great congregation","to":275705,"res":"inferred"},{"n":112,"l":"coupling","k":"pair","v":"none","res":"none"},{"n":116,"l":"locus","k":"value","v":"external:god"},{"n":114,"l":"discovery","k":"note","v":"'From you comes my PRAISE (tehillah) in the great congregation' — praise itself as God's gift; tehillah recurs (v3) — the God enthroned on Israel's praises is now the source of the sufferer's own"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "275711": {"gloss":"fear v25","dims":[{"n":101,"l":"sense","k":"value","v":"fear (yare - those who fear him)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"the God-fearers","to":275711,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"none","res":"none"},{"n":107,"l":"target","k":"pair","v":"none","res":"none"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"none","res":"none"},{"n":116,"l":"locus","k":"value","v":"external:god"},{"n":114,"l":"discovery","k":"note","v":"'my vows I will perform before those who FEAR (yare) him' — the God-fearers as witnesses of his thanksgiving; yare recurs (v23), the reverent community before whom vows are paid"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "275712": {"gloss":"afflicted v26","dims":[{"n":101,"l":"sense","k":"value","v":"afflicted / humble (anav)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"the afflicted/humble","to":275712,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"none","res":"none"},{"n":107,"l":"target","k":"pair","v":"none","res":"none"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"shall eat and be satisfied","from":275712,"to":275714,"res":"span"},{"n":116,"l":"locus","k":"value","v":"internal:ib-state"},{"n":114,"l":"discovery","k":"note","v":"'The AFFLICTED (anav) shall eat and be satisfied' — the reversal of hunger; anav the humble whom God feeds, the sufferer's vindication becoming the whole community's provision"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "275714": {"gloss":"satisfied v26","dims":[{"n":101,"l":"sense","k":"value","v":"be satisfied (saba)"},{"n":102,"l":"type","k":"value","v":"action"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"the afflicted","from":275714,"to":275712,"res":"span"},{"n":106,"l":"operation","k":"event","v":"be satisfied"},{"n":107,"l":"target","k":"pair","v":"none","res":"none"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"the afflicted eat and are filled","from":275714,"to":275712,"res":"span"},{"n":116,"l":"locus","k":"value","v":"internal:ib-state"},{"n":114,"l":"discovery","k":"note","v":"'shall eat and be SATISFIED (saba)' — the filling of the hungry; saba (as Ps17) here a good satiety, the afflicted feasting at the deliverance-meal"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "275715": {"gloss":"seek v26","dims":[{"n":101,"l":"sense","k":"value","v":"seek (darash)"},{"n":102,"l":"type","k":"value","v":"action"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"those who seek him","to":275715,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"seek"},{"n":107,"l":"target","k":"pair","v":"God ('him')","to":275715,"res":"inferred"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"paired with praising","from":275715,"to":275716,"res":"span"},{"n":116,"l":"locus","k":"value","v":"external:god"},{"n":114,"l":"discovery","k":"note","v":"'those who SEEK (darash) him shall praise the LORD' — the seekers who find and praise; darash = the earnest searching after God, rewarded with praise and living hearts"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "275716": {"gloss":"praise v26","dims":[{"n":101,"l":"sense","k":"value","v":"praise (halal)"},{"n":102,"l":"type","k":"value","v":"action"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"those who seek him","from":275716,"to":275715,"res":"span"},{"n":106,"l":"operation","k":"event","v":"praise"},{"n":107,"l":"target","k":"pair","v":"the LORD","to":275716,"res":"inferred"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"paired with seeking","from":275716,"to":275715,"res":"span"},{"n":116,"l":"locus","k":"value","v":"external:god"},{"n":114,"l":"discovery","k":"note","v":"'those who seek him shall PRAISE (halal) the LORD' — praise as the seekers' fruit; halal recurs (v22,23), the widening circle of praise from sufferer to seekers to the ends of the earth"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "275718": {"gloss":"hearts v26","dims":[{"n":101,"l":"sense","k":"value","v":"heart (levav - may your hearts live)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"heart (self)","to":275718,"res":"span"},{"n":105,"l":"bearer","k":"pair","v":"the seekers","to":275718,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"none","res":"none"},{"n":107,"l":"target","k":"pair","v":"none","res":"none"},{"n":108,"l":"manner","k":"pair","v":"forever","to":275718,"res":"inferred"},{"n":112,"l":"coupling","k":"pair","v":"none","res":"none"},{"n":116,"l":"locus","k":"value","v":"internal:seat"},{"n":114,"l":"discovery","k":"note","v":"'May your HEARTS (levav) live forever!' — the blessing of enduring life on the heart; levav here revived and everlasting, the direct reversal of v14's melted, dying lev — the psalm's arc from a heart like wax to hearts that live forever"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "275724": {"gloss":"remember v27","dims":[{"n":101,"l":"sense","k":"value","v":"remember (zakar)"},{"n":102,"l":"type","k":"value","v":"action"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"all the ends of the earth","to":275724,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"remember (and turn to the LORD)"},{"n":107,"l":"target","k":"pair","v":"the LORD","to":275724,"res":"inferred"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"none","res":"none"},{"n":116,"l":"locus","k":"value","v":"external:god"},{"n":114,"l":"discovery","k":"note","v":"'All the ends of the earth shall REMEMBER (zakar) and turn to the LORD' — the universal turning; zakar here the nations' recollection that leads to worship, the sufferer's rescue becoming the world's conversion"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "275749": {"gloss":"himself(soul) v29","dims":[{"n":101,"l":"sense","k":"value","v":"soul / life (nefesh - could not keep himself alive)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"soul (self)","to":275749,"res":"span"},{"n":105,"l":"bearer","k":"pair","v":"the mortal who bows","to":275749,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"none","res":"none"},{"n":107,"l":"target","k":"pair","v":"none","res":"none"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"none","res":"none"},{"n":116,"l":"locus","k":"value","v":"internal:seat"},{"n":114,"l":"discovery","k":"note","v":"'even the one who could not keep himself (nefesh) alive' — mortality bowing before God; nefesh here the life no one can preserve of themselves, all the dying doing homage to the Lord of life"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "275757": {"gloss":"serve v30","dims":[{"n":101,"l":"sense","k":"value","v":"serve (abad)"},{"n":102,"l":"type","k":"value","v":"action"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"posterity","to":275757,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"serve"},{"n":107,"l":"target","k":"pair","v":"the LORD","to":275757,"res":"inferred"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"none","res":"none"},{"n":116,"l":"locus","k":"value","v":"external:god"},{"n":114,"l":"discovery","k":"note","v":"'Posterity shall SERVE (abad) him' — the generations to come in service; abad = worshipful service, the fruit of the deliverance extending to a people yet unborn"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "275763": {"gloss":"righteousness v31","dims":[{"n":101,"l":"sense","k":"value","v":"righteousness (tsedaqah)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"God (his righteousness)","to":275763,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"none","res":"none"},{"n":107,"l":"target","k":"pair","v":"none","res":"none"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"none","res":"none"},{"n":116,"l":"locus","k":"value","v":"external:god"},{"n":114,"l":"discovery","k":"note","v":"'they shall proclaim his RIGHTEOUSNESS (tsedaqah)... that he has done it' — God's saving righteousness declared to the unborn; tsedaqah = his faithful right action, the deliverance itself as the content of the gospel-proclamation that closes the psalm"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "275582": {"gloss":"birth v10","dims":[{"n":101,"l":"sense","k":"value","v":"womb / birth (rechem)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":114,"l":"discovery","k":"note","v":"v10: 'On you was I cast from my BIRTH; from my mother's womb you have been my God' - lifelong belonging to God; the inner reliance reaching back to the womb, the ground of the appeal (God his God from the first)"},{"n":115,"l":"role","k":"value","v":"standalone"}]},
    "275630": {"gloss":"evildoers v16","dims":[{"n":101,"l":"sense","k":"value","v":"evildoers / do evil (ra'a)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":114,"l":"discovery","k":"note","v":"v16: 'a company of EVILDOERS (ra'a) encircles me' - the malicious pack, dogs surrounding him; the hostile collective whose malice presses the sufferer toward death"},{"n":115,"l":"role","k":"value","v":"standalone"}]},
    "275642": {"gloss":"garments v18","dims":[{"n":101,"l":"sense","k":"value","v":"garments (beged)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":114,"l":"discovery","k":"note","v":"v18: 'they divide my GARMENTS... cast lots' - the final humiliation, stripped and gambled over; the sufferer treated as already dead, the depth of his abandonment by man before God's turn"},{"n":115,"l":"role","k":"value","v":"standalone"}]},
    "275650": {"gloss":"help v19","dims":[{"n":101,"l":"sense","k":"value","v":"help / strength (eyaluth - O you my help)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":114,"l":"discovery","k":"note","v":"v19: 'O you my HELP (eyaluth), come quickly to my aid!' - God addressed as the sufferer's strength; the turn from 'none to help' (v11) to God himself as the only help, the plea that God not stay far off"},{"n":115,"l":"role","k":"value","v":"standalone"}]},
    "275617": {"gloss":"dried up v15","dims":[{"n":101,"l":"sense","k":"value","v":"dry up / wither (yabesh)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":114,"l":"discovery","k":"note","v":"v15: 'my strength is DRIED UP (yabesh) like a potsherd, my tongue sticks to my jaws; you lay me in the dust of death' - vitality utterly desiccated; yabesh = the withering of life-force, the body at the point of death, God himself named as the one who lays him in the dust"},{"n":115,"l":"role","k":"value","v":"standalone"}]}
  }
}
