{
  "book": "Psa", "book_id": 19, "chapter": 26, "provenance": "reread-psalms-2026",
  "note": "Ps26 (21 chars). Integrity plea framed by tom (v1,v11). Tried heart: bachan prove + test lev heart & kilyoth mind. chesed+emeth before eyes. Separation from shav/rasha; aheb love of God's house. nefesh not swept with sinners. padah+chanan (echo Ps25). Poetic ledger; span-id pairs.",
  "spans": {
    "276112": {"gloss":"integrity v1","dims":[{"n":101,"l":"sense","k":"value","v":"integrity / completeness (tom)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"David","to":276112,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"none","res":"none"},{"n":107,"l":"target","k":"pair","v":"none","res":"none"},{"n":108,"l":"manner","k":"pair","v":"walked in it","to":276112,"res":"inferred"},{"n":112,"l":"coupling","k":"pair","v":"paired with trust","from":276112,"to":276113,"res":"span"},{"n":116,"l":"locus","k":"value","v":"internal:ib-state"},{"n":114,"l":"discovery","k":"note","v":"'Vindicate me, for I have walked in my INTEGRITY (tom)' — the ground of the appeal; tom (as Ps25:21) the wholeness of life, frames the psalm with v11, the basis on which vindication is sought"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "276113": {"gloss":"trusted v1","dims":[{"n":101,"l":"sense","k":"value","v":"trust (batach)"},{"n":102,"l":"type","k":"value","v":"action"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"David","to":276113,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"trust"},{"n":107,"l":"target","k":"pair","v":"the LORD","to":276113,"res":"inferred"},{"n":108,"l":"manner","k":"pair","v":"without wavering","to":276113,"res":"inferred"},{"n":112,"l":"coupling","k":"pair","v":"paired with integrity","from":276113,"to":276112,"res":"span"},{"n":116,"l":"locus","k":"value","v":"external:god"},{"n":114,"l":"discovery","k":"note","v":"'I have TRUSTED (batach) in the LORD without wavering' — unshaken reliance joined to integrity; batach the steadfast trust that, with tom, grounds the plea for vindication"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "276136": {"gloss":"Prove v2","dims":[{"n":101,"l":"sense","k":"value","v":"prove / assay (bachan)"},{"n":102,"l":"type","k":"value","v":"action"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"God (invited to)","to":276136,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"prove / assay"},{"n":107,"l":"target","k":"pair","v":"heart and mind","from":276136,"to":276141,"res":"span"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"none","res":"none"},{"n":116,"l":"locus","k":"value","v":"external:god"},{"n":114,"l":"discovery","k":"note","v":"'PROVE me (bachan), O LORD, and try me; test my heart and mind' — the confident invitation to divine testing; bachan (as Ps17:3) the assayer's trial, the integrity so sure it welcomes God's scrutiny of the inmost self"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "276141": {"gloss":"heart v2","dims":[{"n":101,"l":"sense","k":"value","v":"heart (lev - test my heart)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"heart (self)","to":276141,"res":"span"},{"n":105,"l":"bearer","k":"pair","v":"David","to":276141,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"none","res":"none"},{"n":107,"l":"target","k":"pair","v":"none","res":"none"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"paired with the kidneys/mind","from":276141,"to":276142,"res":"span"},{"n":116,"l":"locus","k":"value","v":"internal:seat"},{"n":114,"l":"discovery","k":"note","v":"'test my HEART (lev)' — the seat submitted to God's assay; lev paired with kilyoth (mind/kidneys), the inner faculties offered together for divine testing"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "276142": {"gloss":"mind v2","dims":[{"n":101,"l":"sense","k":"value","v":"kidneys / inmost mind (kilyoth)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"kidneys (self)","to":276142,"res":"span"},{"n":105,"l":"bearer","k":"pair","v":"David","to":276142,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"none","res":"none"},{"n":107,"l":"target","k":"pair","v":"none","res":"none"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"paired with the heart","from":276142,"to":276141,"res":"span"},{"n":116,"l":"locus","k":"value","v":"internal:seat"},{"n":114,"l":"discovery","k":"note","v":"'and my MIND (kilyoth)' — the kidneys as the deepest seat of thought/conscience; kilyoth (as Ps16:7) paired with lev, the innermost self bared to God's testing"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "276144": {"gloss":"steadfast love v3","dims":[{"n":101,"l":"sense","k":"value","v":"steadfast love (chesed)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"God (his chesed before David's eyes)","to":276144,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"none","res":"none"},{"n":107,"l":"target","k":"pair","v":"none","res":"none"},{"n":108,"l":"manner","k":"pair","v":"before my eyes","to":276144,"res":"inferred"},{"n":112,"l":"coupling","k":"pair","v":"paired with faithfulness","from":276144,"to":276148,"res":"span"},{"n":116,"l":"locus","k":"value","v":"external:god"},{"n":114,"l":"discovery","k":"note","v":"'your CHESED (steadfast love) is before my eyes, and I walk in your faithfulness' — God's love the constant object of the gaze; chesed kept in view shapes the walk, integrity flowing from beholding grace"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "276148": {"gloss":"faithfulness v3","dims":[{"n":101,"l":"sense","k":"value","v":"faithfulness / truth (emeth)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"God (David walks in it)","to":276148,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"none","res":"none"},{"n":107,"l":"target","k":"pair","v":"none","res":"none"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"paired with steadfast love","from":276148,"to":276144,"res":"span"},{"n":116,"l":"locus","k":"value","v":"external:god"},{"n":114,"l":"discovery","k":"note","v":"'and I walk in your FAITHFULNESS (emeth)' — God's truth as the path of life; emeth (recurs Ps25:5,10) the reliable way David treads, love and truth together forming his conduct"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "276153": {"gloss":"falsehood v4","dims":[{"n":101,"l":"sense","k":"value","v":"falsehood / vanity (shav)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"men of falsehood (avoided)","to":276153,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"none","res":"none"},{"n":107,"l":"target","k":"pair","v":"none","res":"none"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"none","res":"none"},{"n":113,"l":"prohibition","k":"flag","v":"avoided ('I do not sit with men of falsehood')"},{"n":116,"l":"locus","k":"value","v":"external:person"},{"n":114,"l":"discovery","k":"note","v":"'I do not sit with men of FALSEHOOD (shav)' — separation from the deceitful; shav (as Ps24:4) the vain/false company the man of integrity refuses, purity kept by avoided association"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "276157": {"gloss":"hate v5","dims":[{"n":101,"l":"sense","k":"value","v":"hate (sane - the assembly of evildoers)"},{"n":102,"l":"type","k":"value","v":"action"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"David","to":276157,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"hate"},{"n":107,"l":"target","k":"pair","v":"the wicked","from":276157,"to":276163,"res":"span"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"none","res":"none"},{"n":116,"l":"locus","k":"value","v":"internal:ib-state"},{"n":114,"l":"discovery","k":"note","v":"'I HATE (sane) the assembly of evildoers' — righteous hatred of evil company; sane here the good hatred of wickedness (contrast the foes' sane in Ps25:19), moral aversion, refusing to sit with the wicked"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "276163": {"gloss":"wicked v5","dims":[{"n":101,"l":"sense","k":"value","v":"wicked (resha'im)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"the wicked (shunned)","to":276163,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"none","res":"none"},{"n":107,"l":"target","k":"pair","v":"none","res":"none"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"the object of righteous hatred","from":276163,"to":276157,"res":"span"},{"n":113,"l":"prohibition","k":"flag","v":"avoided ('I will not sit with the wicked')"},{"n":116,"l":"locus","k":"value","v":"external:person"},{"n":114,"l":"discovery","k":"note","v":"'and I will not sit with the WICKED (resha'im)' — deliberate separation; resha'im the company the man of tom refuses, the negative side of integrity (cf Ps1:1 not sitting in the seat of scoffers)"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "276166": {"gloss":"innocence v6","dims":[{"n":101,"l":"sense","k":"value","v":"innocence / cleanness (niqqayon)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"David","to":276166,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"wash (hands in it)","to":276166,"res":"inferred"},{"n":107,"l":"target","k":"pair","v":"none","res":"none"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"none","res":"none"},{"n":116,"l":"locus","k":"value","v":"internal:ib-state"},{"n":114,"l":"discovery","k":"note","v":"'I wash my hands in INNOCENCE (niqqayon), and go around your altar' — ritual cleanness enacting inner purity; niqqayon = the innocence the worshipper claims to approach God (cf clean hands, Ps24:4)"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "276171": {"gloss":"thanksgiving v7","dims":[{"n":101,"l":"sense","k":"value","v":"thanksgiving (todah)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"David","to":276171,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"proclaim aloud","to":276171,"res":"inferred"},{"n":107,"l":"target","k":"pair","v":"God","to":276171,"res":"inferred"},{"n":108,"l":"manner","k":"pair","v":"aloud","to":276171,"res":"inferred"},{"n":112,"l":"coupling","k":"pair","v":"none","res":"none"},{"n":116,"l":"locus","k":"value","v":"external:god"},{"n":114,"l":"discovery","k":"note","v":"'proclaiming THANKSGIVING (todah) aloud, telling all your wondrous deeds' — worship as public gratitude; todah the thank-offering of the voice, the integrity that draws near also declares God's works"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "276177": {"gloss":"love v8","dims":[{"n":101,"l":"sense","k":"value","v":"love (aheb - the habitation of your house)"},{"n":102,"l":"type","k":"value","v":"action"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"David","to":276177,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"love"},{"n":107,"l":"target","k":"pair","v":"the habitation of God's house","to":276177,"res":"inferred"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"where God's glory dwells","from":276177,"to":276182,"res":"span"},{"n":116,"l":"locus","k":"value","v":"external:god"},{"n":114,"l":"discovery","k":"note","v":"'I LOVE (aheb) the habitation of your house' — affection for God's dwelling; aheb (the standard love-verb, distinct from racham Ps18:1) directed to the place of God's presence, the worshipper's delight in the sanctuary"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "276182": {"gloss":"glory v8","dims":[{"n":101,"l":"sense","k":"value","v":"glory (kavod - where your glory dwells)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"God (his glory)","to":276182,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"none","res":"none"},{"n":107,"l":"target","k":"pair","v":"none","res":"none"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"the loved dwelling","from":276182,"to":276177,"res":"span"},{"n":116,"l":"locus","k":"value","v":"external:god"},{"n":114,"l":"discovery","k":"note","v":"'the place where your GLORY (kavod) dwells' — God's glory as what makes the house lovely; kavod (as Ps24) the presence David loves, the sanctuary precious because glory abides there"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "276186": {"gloss":"soul v9","dims":[{"n":101,"l":"sense","k":"value","v":"soul / life (nefesh - sweep not away)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"soul (self)","to":276186,"res":"span"},{"n":105,"l":"bearer","k":"pair","v":"David","to":276186,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"none","res":"none"},{"n":107,"l":"target","k":"pair","v":"not swept with sinners","from":276186,"to":276188,"res":"span"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"none","res":"none"},{"n":113,"l":"prohibition","k":"flag","v":"deprecated ('Do NOT sweep my soul away with sinners')"},{"n":116,"l":"locus","k":"value","v":"internal:seat"},{"n":114,"l":"discovery","k":"note","v":"'Do not sweep my SOUL (nefesh) away with sinners' — the plea not to share the fate of the wicked; nefesh the life David begs be separated from the doom of the bloodthirsty, integrity pleading distinct destiny"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "276188": {"gloss":"sinners v9","dims":[{"n":101,"l":"sense","k":"value","v":"sinners (chatta)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"sinners / bloodthirsty men","to":276188,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"none","res":"none"},{"n":107,"l":"target","k":"pair","v":"none","res":"none"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"whose fate the soul must not share","from":276188,"to":276186,"res":"span"},{"n":116,"l":"locus","k":"value","v":"external:person"},{"n":114,"l":"discovery","k":"note","v":"'with SINNERS (chatta)... bloodthirsty men' — those from whose judgement David asks to be spared; chatta (recurs Ps25:8) here the doomed company, hands full of evil devices and bribes (v10)"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "276119": {"gloss":"evil v10","dims":[{"n":101,"l":"sense","k":"value","v":"evil device / lewdness (zimmah)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"the sinners (in whose hands)","to":276119,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"none","res":"none"},{"n":107,"l":"target","k":"pair","v":"none","res":"none"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"none","res":"none"},{"n":116,"l":"locus","k":"value","v":"internal:ib-state"},{"n":114,"l":"discovery","k":"note","v":"'in whose hands are EVIL devices (zimmah), and whose right hands are full of bribes' — the wicked characterised by scheming and corruption; zimmah = calculated wickedness, the inner depravity that fills their hands (contrast David's hands washed in innocence, v6)"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "276125": {"gloss":"integrity v11","dims":[{"n":101,"l":"sense","k":"value","v":"integrity (tom)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"David","to":276125,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"none","res":"none"},{"n":107,"l":"target","k":"pair","v":"none","res":"none"},{"n":108,"l":"manner","k":"pair","v":"walk in it","to":276125,"res":"inferred"},{"n":112,"l":"coupling","k":"pair","v":"paired with the plea to redeem","from":276125,"to":276126,"res":"span"},{"n":116,"l":"locus","k":"value","v":"internal:ib-state"},{"n":114,"l":"discovery","k":"note","v":"'But as for me, I shall walk in my INTEGRITY (tom); redeem me' — tom closes the frame (v1); resolve for the future joined to the plea for grace, integrity and dependence held together"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "276126": {"gloss":"redeem v11","dims":[{"n":101,"l":"sense","k":"value","v":"redeem / ransom (padah)"},{"n":102,"l":"type","k":"value","v":"action"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"God (asked to)","to":276126,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"redeem"},{"n":107,"l":"target","k":"pair","v":"David","to":276126,"res":"inferred"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"paired with be gracious","from":276126,"to":276127,"res":"span"},{"n":116,"l":"locus","k":"value","v":"external:god"},{"n":114,"l":"discovery","k":"note","v":"'REDEEM (padah) me, and be gracious to me' — integrity pleading grace, not merit; padah (echoes Ps25:22) the ransom sought even by the man of tom, who still needs redemption"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "276127": {"gloss":"gracious v11","dims":[{"n":101,"l":"sense","k":"value","v":"be gracious (chanan)"},{"n":102,"l":"type","k":"value","v":"action"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"God (asked to)","to":276127,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"be gracious"},{"n":107,"l":"target","k":"pair","v":"David","to":276127,"res":"inferred"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"paired with redeem","from":276127,"to":276126,"res":"span"},{"n":116,"l":"locus","k":"value","v":"external:god"},{"n":114,"l":"discovery","k":"note","v":"'and be GRACIOUS (chanan) to me' — the appeal to free favour; chanan (echoes Ps25:16) the grace even the upright depends on, integrity and grace not opposed but joined"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "276134": {"gloss":"bless v12","dims":[{"n":101,"l":"sense","k":"value","v":"bless (barak)"},{"n":102,"l":"type","k":"value","v":"action"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"David","to":276134,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"bless"},{"n":107,"l":"target","k":"pair","v":"the LORD","to":276134,"res":"inferred"},{"n":108,"l":"manner","k":"pair","v":"in the great assembly","to":276134,"res":"inferred"},{"n":112,"l":"coupling","k":"pair","v":"none","res":"none"},{"n":116,"l":"locus","k":"value","v":"external:god"},{"n":114,"l":"discovery","k":"note","v":"'My foot stands on level ground; in the great assembly I will BLESS (barak) the LORD' — the resolution of the plea in praise; barak the blessing of God from firm footing, the vindicated worshipper standing secure among the congregation"},{"n":115,"l":"role","k":"value","v":"characteristic"}]}
