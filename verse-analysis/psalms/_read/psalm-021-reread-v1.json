  "note": "Ps21 (23 chars). King's thanksgiving. Joy-cluster samach/gil/chadah/simchah (distinct nuances). lev+taavah heart's desire. batach+chesed (trust keeps unmoved). aph God's wrath. v11 enemy's malice ra/chashab/mezimmah. Poetic ledger; span-id pairs.",
  "spans": {
    "275479": {"gloss":"rejoices v1","dims":[{"n":101,"l":"sense","k":"value","v":"rejoice (samach)"},{"n":102,"l":"type","k":"value","v":"action"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"the king","to":275479,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"rejoice"},{"n":107,"l":"target","k":"pair","v":"in your strength","to":275479,"res":"inferred"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"paired with exulting","from":275479,"to":275482,"res":"span"},{"n":116,"l":"locus","k":"value","v":"internal:ib-state"},{"n":114,"l":"discovery","k":"note","v":"'in your strength the king REJOICES (samach)' — the king's joy grounded in God's power, not his own; samach the steady gladness, paired with the more exuberant gil (exults) of the same verse"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "275480": {"gloss":"salvation v1","dims":[{"n":101,"l":"sense","k":"value","v":"salvation (yeshuah)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"the king (God his salvation)","to":275480,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"none","res":"none"},{"n":107,"l":"target","k":"pair","v":"none","res":"none"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"the object of his exulting","from":275480,"to":275482,"res":"span"},{"n":116,"l":"locus","k":"value","v":"external:god"},{"n":114,"l":"discovery","k":"note","v":"'in your SALVATION (yeshuah) how greatly he exults' — deliverance as the ground of joy; yeshuah recurs v5, the salvation that both gladdens and glorifies the king"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "275482": {"gloss":"exults v1","dims":[{"n":101,"l":"sense","k":"value","v":"exult / rejoice greatly (gil)"},{"n":102,"l":"type","k":"value","v":"action"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"the king","to":275482,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"exult"},{"n":107,"l":"target","k":"pair","v":"in your salvation","from":275482,"to":275480,"res":"span"},{"n":108,"l":"manner","k":"pair","v":"how greatly","to":275482,"res":"inferred"},{"n":112,"l":"coupling","k":"pair","v":"paired with rejoicing","from":275482,"to":275479,"res":"span"},{"n":116,"l":"locus","k":"value","v":"internal:ib-state"},{"n":114,"l":"discovery","k":"note","v":"'how greatly he EXULTS (gil)' — the intensifier of the king's joy; gil = the leaping/spinning exultation, joy at its height, distinct from the quieter samach it stands beside"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "275502": {"gloss":"heart v2","dims":[{"n":101,"l":"sense","k":"value","v":"heart (lev - heart's desire)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"heart (self)","to":275502,"res":"span"},{"n":105,"l":"bearer","k":"pair","v":"the king","to":275502,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"none","res":"none"},{"n":107,"l":"target","k":"pair","v":"none","res":"none"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"its desire granted","from":275502,"to":275503,"res":"span"},{"n":116,"l":"locus","k":"value","v":"internal:seat"},{"n":114,"l":"discovery","k":"note","v":"'You have given him his HEART'S (lev) desire' — the seat whose longing God fulfils; the petition of v20:4 now answered, the king's inmost wish granted"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "275503": {"gloss":"desire v2","dims":[{"n":101,"l":"sense","k":"value","v":"desire / longing (taavah)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"the king","to":275503,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"none","res":"none"},{"n":107,"l":"target","k":"pair","v":"none","res":"none"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"of the heart","from":275503,"to":275502,"res":"span"},{"n":116,"l":"locus","k":"value","v":"internal:ib-state"},{"n":114,"l":"discovery","k":"note","v":"the DESIRE (taavah) of the heart God grants — the object of longing fulfilled; taavah here rightly directed and satisfied, 'not withheld the request of his lips'"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "275510": {"gloss":"blessings v3","dims":[{"n":101,"l":"sense","k":"value","v":"blessings (berakah)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"God (bestows on the king)","to":275510,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"meet with","to":275510,"res":"inferred"},{"n":107,"l":"target","k":"pair","v":"the king","to":275510,"res":"inferred"},{"n":108,"l":"manner","k":"pair","v":"rich","to":275510,"res":"inferred"},{"n":112,"l":"coupling","k":"pair","v":"none","res":"none"},{"n":116,"l":"locus","k":"value","v":"external:god"},{"n":114,"l":"discovery","k":"note","v":"'you meet him with rich BLESSINGS (berakah)' — God's anticipating goodness; berakah = the good gifts that meet the king before he asks, crowning him with gold"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "275523": {"gloss":"glory v5","dims":[{"n":101,"l":"sense","k":"value","v":"glory (kavod - the king's)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"the king","to":275523,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"none","res":"none"},{"n":107,"l":"target","k":"pair","v":"none","res":"none"},{"n":108,"l":"manner","k":"pair","v":"great through your salvation","from":275523,"to":275525,"res":"span"},{"n":112,"l":"coupling","k":"pair","v":"none","res":"none"},{"n":116,"l":"locus","k":"value","v":"external:god"},{"n":114,"l":"discovery","k":"note","v":"'His GLORY (kavod) is great through your salvation' — the king's honour derived, not intrinsic; kavod bestowed by God's saving act, splendour and majesty laid on him from above"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "275525": {"gloss":"salvation v5","dims":[{"n":101,"l":"sense","k":"value","v":"salvation (yeshuah)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"the king (through God's salvation)","to":275525,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"none","res":"none"},{"n":107,"l":"target","k":"pair","v":"none","res":"none"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"the king's glory is great through it","from":275525,"to":275523,"res":"span"},{"n":116,"l":"locus","k":"value","v":"external:god"},{"n":114,"l":"discovery","k":"note","v":"'great through your SALVATION (yeshuah)' — salvation as the source of the king's exalted state; yeshuah again the engine of both his joy (v1) and his honour (v5)"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "275526": {"gloss":"splendor v5","dims":[{"n":101,"l":"sense","k":"value","v":"splendour / majesty (hod)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"the king (bestowed by God)","to":275526,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"none","res":"none"},{"n":107,"l":"target","k":"pair","v":"none","res":"none"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"paired with majesty","from":275526,"to":275527,"res":"span"},{"n":116,"l":"locus","k":"value","v":"external:god"},{"n":114,"l":"discovery","k":"note","v":"'SPLENDOUR (hod) and majesty you bestow on him' — royal glory as a divine gift; hod = the regal radiance God lays on the king, not self-generated majesty"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "275527": {"gloss":"majesty v5","dims":[{"n":101,"l":"sense","k":"value","v":"majesty / honour (hadar)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"the king","to":275527,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"none","res":"none"},{"n":107,"l":"target","k":"pair","v":"none","res":"none"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"paired with splendour","from":275527,"to":275526,"res":"span"},{"n":116,"l":"locus","k":"value","v":"external:god"},{"n":114,"l":"discovery","k":"note","v":"'MAJESTY (hadar) you bestow on him' — the honour-glory twinned with hod; hadar = the dignity conferred, the king robed in a splendour that is God's endowment"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "275532": {"gloss":"most blessed v6","dims":[{"n":101,"l":"sense","k":"value","v":"blessings / make blessed (berakah)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"the king (made blessed by God)","to":275532,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"none","res":"none"},{"n":107,"l":"target","k":"pair","v":"none","res":"none"},{"n":108,"l":"manner","k":"pair","v":"forever","to":275532,"res":"inferred"},{"n":112,"l":"coupling","k":"pair","v":"paired with the gladness of God's presence","from":275532,"to":275534,"res":"span"},{"n":116,"l":"locus","k":"value","v":"external:god"},{"n":114,"l":"discovery","k":"note","v":"'you make him MOST BLESSED (berakah) forever' — blessing intensified and perpetual; berakah recurs (v3), now the king made a fountain of blessing, the crown of the gifts"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "275534": {"gloss":"glad v6","dims":[{"n":101,"l":"sense","k":"value","v":"make glad / gladden (chadah)"},{"n":102,"l":"type","k":"value","v":"action"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"God","to":275534,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"make glad"},{"n":107,"l":"target","k":"pair","v":"the king","to":275534,"res":"inferred"},{"n":108,"l":"manner","k":"pair","v":"with the joy of your presence","from":275534,"to":275535,"res":"span"},{"n":112,"l":"coupling","k":"pair","v":"paired with being made blessed","from":275534,"to":275532,"res":"span"},{"n":116,"l":"locus","k":"value","v":"internal:ib-state"},{"n":114,"l":"discovery","k":"note","v":"'you make him GLAD (chadah) with the joy of your presence' — the deepest gladness is God's face; chadah = to gladden, and its source is not victory but the divine presence itself, the crown of the king's joy"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "275535": {"gloss":"joy v6","dims":[{"n":101,"l":"sense","k":"value","v":"joy (simchah - of your presence)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"the king","to":275535,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"none","res":"none"},{"n":107,"l":"target","k":"pair","v":"God's presence","to":275535,"res":"inferred"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"the gladness is with it","from":275535,"to":275534,"res":"span"},{"n":116,"l":"locus","k":"value","v":"internal:ib-state"},{"n":114,"l":"discovery","k":"note","v":"'the JOY (simchah) of your presence' — the joy located in God's face; simchah here (the noun) crowns the joy-cluster (samach/gil/chadah), the presence of God the true fountain of gladness (cf Ps16:11 fullness of joy)"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "275539": {"gloss":"trusts v7","dims":[{"n":101,"l":"sense","k":"value","v":"trust (batach)"},{"n":102,"l":"type","k":"value","v":"action"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"the king","to":275539,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"trust"},{"n":107,"l":"target","k":"pair","v":"the LORD","to":275539,"res":"inferred"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"through God's steadfast love unmoved","from":275539,"to":275541,"res":"span"},{"n":116,"l":"locus","k":"value","v":"external:god"},{"n":114,"l":"discovery","k":"note","v":"'the king TRUSTS (batach) in the LORD' — the ground of his security; batach the settled reliance, the true 'trust' the whole royal joy rests on (the counterpart to Ps20:7's chariots-vs-name)"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "275541": {"gloss":"steadfast love v7","dims":[{"n":101,"l":"sense","k":"value","v":"steadfast love (chesed)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"the Most High","to":275541,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"none","res":"none"},{"n":107,"l":"target","k":"pair","v":"the king","to":275541,"res":"inferred"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"through it he shall not be moved","from":275541,"to":275539,"res":"span"},{"n":116,"l":"locus","k":"value","v":"external:god"},{"n":114,"l":"discovery","k":"note","v":"'through the CHESED (steadfast love) of the Most High he shall not be moved' — God's covenant loyalty as the king's stability; chesed the divine constancy that answers the king's batach, keeping him unshaken"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "275552": {"gloss":"hate v8","dims":[{"n":101,"l":"sense","k":"value","v":"hate (sane - those who hate you)"},{"n":102,"l":"type","k":"value","v":"action"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"the enemies","to":275552,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"hate"},{"n":107,"l":"target","k":"pair","v":"God / the king","to":275552,"res":"inferred"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"none","res":"none"},{"n":116,"l":"locus","k":"value","v":"external:person"},{"n":114,"l":"discovery","k":"note","v":"'your right hand will find out those who HATE (sane) you' — the enemies defined by their hatred; sane recurs (Ps18) as the settled hostility God's hand will overtake"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "275561": {"gloss":"wrath v9","dims":[{"n":101,"l":"sense","k":"value","v":"wrath / anger (aph)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"God's anger (aph)","to":275561,"res":"span"},{"n":105,"l":"bearer","k":"pair","v":"the LORD","to":275561,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"none","res":"none"},{"n":107,"l":"target","k":"pair","v":"the enemies","to":275561,"res":"inferred"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"none","res":"none"},{"n":116,"l":"locus","k":"value","v":"external:god"},{"n":114,"l":"discovery","k":"note","v":"'the LORD will swallow them up in his WRATH (aph)' — divine anger consuming the foe; aph (nostrils/anger, as in Ps18:8) here the burning wrath that makes them a blazing oven"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "275490": {"gloss":"evil v11","dims":[{"n":101,"l":"sense","k":"value","v":"evil (ra - they plan evil)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"the enemies","to":275490,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"none","res":"none"},{"n":107,"l":"target","k":"pair","v":"against you (God/king)","to":275490,"res":"inferred"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"paired with devising mischief","from":275490,"to":275491,"res":"span"},{"n":116,"l":"locus","k":"value","v":"internal:ib-state"},{"n":114,"l":"discovery","k":"note","v":"'though they plan EVIL (ra) against you' — the enemy's malicious intent; ra the harm they purpose, the first of the trio ra/chashab/mezimmah that maps the wicked's inner scheming"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "275491": {"gloss":"devise v11","dims":[{"n":101,"l":"sense","k":"value","v":"devise / scheme (chashab)"},{"n":102,"l":"type","k":"value","v":"action"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"the enemies","to":275491,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"devise"},{"n":107,"l":"target","k":"pair","v":"mischief","from":275491,"to":275492,"res":"span"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"paired with evil plans","from":275491,"to":275490,"res":"span"},{"n":116,"l":"locus","k":"value","v":"internal:ib-state"},{"n":114,"l":"discovery","k":"note","v":"'they DEVISE (chashab) mischief' — the calculating inner work of malice; chashab = to plot/reckon, the mind's machinery of the wicked, doomed to fail ('they will not succeed')"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "275492": {"gloss":"mischief v11","dims":[{"n":101,"l":"sense","k":"value","v":"mischief / scheme (mezimmah)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"the enemies","to":275492,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"none","res":"none"},{"n":107,"l":"target","k":"pair","v":"none","res":"none"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"the thing devised","from":275492,"to":275491,"res":"span"},{"n":116,"l":"locus","k":"value","v":"internal:ib-state"},{"n":114,"l":"discovery","k":"note","v":"the MISCHIEF (mezimmah) they devise — the plot itself; mezimmah = a scheme/device (neutral root, here evil), the concrete plan born of the plotting heart, which cannot prevail against God"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "275494": {"gloss":"exalted v13","dims":[{"n":101,"l":"sense","k":"value","v":"be exalted (rum)"},{"n":102,"l":"type","k":"value","v":"action"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"the LORD","to":275494,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"be exalted"},{"n":107,"l":"target","k":"pair","v":"none","res":"none"},{"n":108,"l":"manner","k":"pair","v":"in your strength","to":275494,"res":"inferred"},{"n":112,"l":"coupling","k":"pair","v":"paired with singing praise","from":275494,"to":275497,"res":"span"},{"n":116,"l":"locus","k":"value","v":"external:god"},{"n":114,"l":"discovery","k":"note","v":"'Be EXALTED (rum), O LORD, in your strength' — the closing doxological cry; rum turned Godward, the congregation lifting up the God whose strength gave the king his joy (frames the psalm with v1)"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "275497": {"gloss":"sing v13","dims":[{"n":101,"l":"sense","k":"value","v":"sing (shir)"},{"n":102,"l":"type","k":"value","v":"action"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"the congregation ('we')","to":275497,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"sing"},{"n":107,"l":"target","k":"pair","v":"God's power","to":275497,"res":"inferred"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"paired with praise","from":275497,"to":275498,"res":"span"},{"n":116,"l":"locus","k":"value","v":"external:god"},{"n":114,"l":"discovery","k":"note","v":"'We will SING (shir) and praise your power' — the corporate response of song; shir the sung celebration, paired with zamar (make music), the people's answer to God's strength"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "275498": {"gloss":"praise v13","dims":[{"n":101,"l":"sense","k":"value","v":"praise / make music (zamar)"},{"n":102,"l":"type","k":"value","v":"action"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"the congregation ('we')","to":275498,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"make music / praise"},{"n":107,"l":"target","k":"pair","v":"God's power","to":275498,"res":"inferred"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"paired with singing","from":275498,"to":275497,"res":"span"},{"n":116,"l":"locus","k":"value","v":"external:god"},{"n":114,"l":"discovery","k":"note","v":"'and PRAISE (zamar) your power' — the musical praise completing the doxology; zamar paired with shir, song and instrument together celebrating God's might"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "275521": {"gloss":"forever v4","dims":[{"n":101,"l":"sense","k":"value","v":"life / length of days (in answer to asking)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":114,"l":"discovery","k":"note","v":"v4: 'He asked LIFE of you; you gave it, length of days FOREVER' - the king's petition for life granted beyond measure; the inner act of asking answered with everlasting days, the messianic reach of the royal blessing"},{"n":115,"l":"role","k":"value","v":"standalone"}]}
  }
