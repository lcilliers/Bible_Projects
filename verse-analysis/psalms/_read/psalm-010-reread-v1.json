    "270384": {"gloss":"heart v13","dims":[{"n":101,"l":"sense","k":"value","v":"heart (lev)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"heart (self)","to":270384,"res":"span"},{"n":105,"l":"bearer","k":"pair","v":"the wicked","to":270384,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"none","res":"none"},{"n":107,"l":"target","k":"pair","v":"none","res":"none"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"none","res":"none"},{"n":116,"l":"locus","k":"value","v":"internal:seat"},{"n":114,"l":"discovery","k":"note","v":"the wicked SAYS IN HIS HEART 'you will not call to account' — 3rd 'in his heart' (v6,11,13); the presumption of impunity; the inner reasoning that God won't judge (refuted v14-15)"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
