  "spans": {
    "275239": {"gloss":"glory v1","dims":[{"n":101,"l":"sense","k":"value","v":"glory (kavod - of God)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"God (declared by the heavens)","to":275239,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"none","res":"none"},{"n":107,"l":"target","k":"pair","v":"none","res":"none"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"none","res":"none"},{"n":116,"l":"locus","k":"value","v":"external:god"},{"n":114,"l":"discovery","k":"note","v":"'The heavens declare the GLORY (kavod) of God' — creation as the wordless herald of divine glory; kavod = the weighty splendour the skies proclaim, the first witness of the psalm"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "275295": {"gloss":"knowledge v2","dims":[{"n":101,"l":"sense","k":"value","v":"knowledge (daath)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"night to night (creation)","to":275295,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"none","res":"none"},{"n":107,"l":"target","k":"pair","v":"none","res":"none"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"none","res":"none"},{"n":116,"l":"locus","k":"value","v":"external:thing"},{"n":114,"l":"discovery","k":"note","v":"'night to night reveals KNOWLEDGE (daath)' — creation's ceaseless teaching; daath = the knowledge of God the ordered cosmos pours out, wordless yet instructing"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "275310": {"gloss":"joy v5","dims":[{"n":101,"l":"sense","k":"value","v":"rejoice / exult (sus)"},{"n":102,"l":"type","k":"value","v":"action"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"the sun (like a strong man)","to":275310,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"rejoice / exult"},{"n":107,"l":"target","k":"pair","v":"none","res":"none"},{"n":108,"l":"manner","k":"pair","v":"running its course","to":275310,"res":"inferred"},{"n":112,"l":"coupling","k":"pair","v":"none","res":"none"},{"n":116,"l":"locus","k":"value","v":"external:thing"},{"n":114,"l":"discovery","k":"note","v":"the sun 'like a strong man runs its course with JOY (sus)' — creation's exultation personified; sus = the glad vigour of the sun-runner, joy woven into the created order's obedience"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "306144": {"gloss":"hidden v6","dims":[{"n":101,"l":"sense","k":"value","v":"hidden / concealed (sathar, negated)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"nothing (is hidden from the sun's heat)","to":306144,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"none","res":"none"},{"n":107,"l":"target","k":"pair","v":"none","res":"none"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"none","res":"none"},{"n":113,"l":"prohibition","k":"flag","v":"negated ('nothing is HIDDEN from its heat')"},{"n":116,"l":"locus","k":"value","v":"external:thing"},{"n":114,"l":"discovery","k":"note","v":"'nothing is HIDDEN (sathar) from its heat' — the sun's all-exposing reach; sathar here bridges to v12's 'hidden faults' — as nothing escapes the sun, so nothing escapes God, the psalm's pivot from cosmos to conscience"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "275313": {"gloss":"perfect v7","dims":[{"n":101,"l":"sense","k":"value","v":"perfect / whole (tamim - the law)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"the law of the LORD","to":275313,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"none","res":"none"},{"n":107,"l":"target","k":"pair","v":"none","res":"none"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"reviving the soul","from":275313,"to":275315,"res":"span"},{"n":116,"l":"locus","k":"value","v":"external:thing"},{"n":114,"l":"discovery","k":"note","v":"'The law of the LORD is PERFECT (tamim), reviving the soul' — the Torah's wholeness; tamim (elsewhere of God's way, Ps18:30) now of his word, and its effect is to restore the inner life"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "275315": {"gloss":"soul v7","dims":[{"n":101,"l":"sense","k":"value","v":"soul / life (nefesh)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"soul (self)","to":275315,"res":"span"},{"n":105,"l":"bearer","k":"pair","v":"the person (revived)","to":275315,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"none","res":"none"},{"n":107,"l":"target","k":"pair","v":"none","res":"none"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"revived by the perfect law","from":275315,"to":275313,"res":"span"},{"n":116,"l":"locus","k":"value","v":"internal:seat"},{"n":114,"l":"discovery","k":"note","v":"the perfect law 'REVIVING the SOUL (nefesh)' — the Torah restores the whole living self; nefesh here = the life brought back, refreshed and re-animated by God's word"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "275319": {"gloss":"wise v7","dims":[{"n":101,"l":"sense","k":"value","v":"make wise (chakam, hiphil)"},{"n":102,"l":"type","k":"value","v":"action"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"the testimony of the LORD","to":275319,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"make wise"},{"n":107,"l":"target","k":"pair","v":"the simple","to":275319,"res":"inferred"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"none","res":"none"},{"n":116,"l":"locus","k":"value","v":"internal:ib-state"},{"n":114,"l":"discovery","k":"note","v":"the sure testimony 'making WISE (chakam) the simple' — the word imparts wisdom to the naive; chakam = the transformation of the untaught mind, God's word as the teacher of the simple"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "275323": {"gloss":"right v8","dims":[{"n":101,"l":"sense","k":"value","v":"right / upright (yashar - the precepts)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"the precepts of the LORD","to":275323,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"none","res":"none"},{"n":107,"l":"target","k":"pair","v":"none","res":"none"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"rejoicing the heart","from":275323,"to":275324,"res":"span"},{"n":116,"l":"locus","k":"value","v":"external:thing"},{"n":114,"l":"discovery","k":"note","v":"'the precepts of the LORD are RIGHT (yashar), rejoicing the heart' — the straightness of God's precepts; yashar = the moral uprightness that, being true, gladdens the inner man"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "275324": {"gloss":"rejoicing v8","dims":[{"n":101,"l":"sense","k":"value","v":"rejoice / gladden (samach)"},{"n":102,"l":"type","k":"value","v":"action"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"the precepts","from":275324,"to":275323,"res":"span"},{"n":106,"l":"operation","k":"event","v":"gladden"},{"n":107,"l":"target","k":"pair","v":"the heart","from":275324,"to":275325,"res":"span"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"of the heart","from":275324,"to":275325,"res":"span"},{"n":116,"l":"locus","k":"value","v":"internal:ib-state"},{"n":114,"l":"discovery","k":"note","v":"the precepts 'REJOICING (samach) the heart' — God's word acting on the affections; samach = the gladness the right law produces in the heart, not mere duty but delight"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "275325": {"gloss":"heart v8","dims":[{"n":101,"l":"sense","k":"value","v":"heart (lev)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"heart (self)","to":275325,"res":"span"},{"n":105,"l":"bearer","k":"pair","v":"the person","to":275325,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"none","res":"none"},{"n":107,"l":"target","k":"pair","v":"none","res":"none"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"gladdened by the precepts","from":275325,"to":275324,"res":"span"},{"n":116,"l":"locus","k":"value","v":"internal:seat"},{"n":114,"l":"discovery","k":"note","v":"the HEART (lev) that the precepts gladden — the seat of the Torah's joy; this lev (gladdened by the word) is distinct from v14's lev (whose meditation must be acceptable) — the word both fills and is tested by the heart"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "275331": {"gloss":"fear v9","dims":[{"n":101,"l":"sense","k":"value","v":"fear (of the LORD) (yirah)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"the fear of the LORD (as a name for the law)","to":275331,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"none","res":"none"},{"n":107,"l":"target","k":"pair","v":"none","res":"none"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"none","res":"none"},{"n":116,"l":"locus","k":"value","v":"external:god"},{"n":114,"l":"discovery","k":"note","v":"'the FEAR (yirah) of the LORD is clean, enduring forever' — reverent fear named among the synonyms for the law; yirah = the God-directed awe that is pure and everlasting, the inward correlate of the written word"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "275338": {"gloss":"true v9","dims":[{"n":101,"l":"sense","k":"value","v":"truth (emeth - the rules are true)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"the rules of the LORD","to":275338,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"none","res":"none"},{"n":107,"l":"target","k":"pair","v":"none","res":"none"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"paired with righteous altogether","from":275338,"to":275339,"res":"span"},{"n":116,"l":"locus","k":"value","v":"external:thing"},{"n":114,"l":"discovery","k":"note","v":"'the rules of the LORD are TRUE (emeth), and righteous altogether' — the reliability of God's ordinances; emeth = the firmness/faithfulness of the rules, the crown of the six-fold Torah-praise"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "275339": {"gloss":"righteous v9","dims":[{"n":101,"l":"sense","k":"value","v":"be righteous (tsadeq)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"the rules of the LORD","to":275339,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"none","res":"none"},{"n":107,"l":"target","k":"pair","v":"none","res":"none"},{"n":108,"l":"manner","k":"pair","v":"altogether","to":275339,"res":"inferred"},{"n":112,"l":"coupling","k":"pair","v":"paired with true","from":275339,"to":275338,"res":"span"},{"n":116,"l":"locus","k":"value","v":"external:thing"},{"n":114,"l":"discovery","k":"note","v":"the rules 'RIGHTEOUS (tsadeq) altogether' — the wholesale justice of God's law; tsadeq = the rightness that permeates every rule, no part of it unjust"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "275244": {"gloss":"desired v10","dims":[{"n":101,"l":"sense","k":"value","v":"be desired / coveted (chamad)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"the law/rules (more desired than gold)","to":275244,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"none","res":"none"},{"n":107,"l":"target","k":"pair","v":"none","res":"none"},{"n":108,"l":"manner","k":"pair","v":"more than gold, sweeter than honey","to":275244,"res":"inferred"},{"n":112,"l":"coupling","k":"pair","v":"none","res":"none"},{"n":116,"l":"locus","k":"value","v":"internal:ib-state"},{"n":114,"l":"discovery","k":"note","v":"'more to be DESIRED (chamad) than gold... sweeter than honey' — the law as the supreme object of longing; chamad = the covetous desire, here rightly directed to God's word above all treasure and pleasure"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "275266": {"gloss":"hidden(faults) v12","dims":[{"n":101,"l":"sense","k":"value","v":"hidden things / secret faults (sathar)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"David (his hidden faults)","to":275266,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"none","res":"none"},{"n":107,"l":"target","k":"pair","v":"none","res":"none"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"none","res":"none"},{"n":116,"l":"locus","k":"value","v":"internal:ib-state"},{"n":114,"l":"discovery","k":"note","v":"'Declare me innocent from HIDDEN faults (sathar)' — sins unknown even to oneself; sathar here = the concealed errors the psalmist cannot discern, echoing v6's 'nothing hidden' — the sun exposes all, so he asks God to cleanse what even he cannot see. First rung of the sin-gradation (hidden -> presumptuous -> great transgression)"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "275270": {"gloss":"presumptuous v13","dims":[{"n":101,"l":"sense","k":"value","v":"presumptuous / insolent (zed)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"presumptuous sins (that would rule him)","to":275270,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"have dominion","to":275270,"res":"inferred"},{"n":107,"l":"target","k":"pair","v":"David ('let them not rule over me')","to":275270,"res":"inferred"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"none","res":"none"},{"n":113,"l":"prohibition","k":"flag","v":"guarded-against ('keep back your servant from... let them not rule')"},{"n":116,"l":"locus","k":"value","v":"internal:ib-state"},{"n":114,"l":"discovery","k":"note","v":"'Keep back your servant from PRESUMPTUOUS sins (zed); let them not have dominion' — deliberate, defiant sins that seek to enslave; zed = the insolent, high-handed transgression, the middle rung above hidden faults, feared as a would-be master"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "275277": {"gloss":"transgression v13","dims":[{"n":101,"l":"sense","k":"value","v":"transgression / rebellion (pesha - great transgression)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"David (kept innocent of it)","to":275277,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"none","res":"none"},{"n":107,"l":"target","k":"pair","v":"none","res":"none"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"none","res":"none"},{"n":113,"l":"prohibition","k":"flag","v":"guarded-against ('innocent of great transgression')"},{"n":116,"l":"locus","k":"value","v":"internal:ib-state"},{"n":114,"l":"discovery","k":"note","v":"'innocent of GREAT TRANSGRESSION (pesha)' — the highest rung of the gradation; pesha = rebellion, the breach of covenant loyalty; the goal 'then I shall be blameless' is freedom from hidden, presumptuous, AND rebellious sin alike"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "275281": {"gloss":"heart v14","dims":[{"n":101,"l":"sense","k":"value","v":"heart (lev - meditation of my heart)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"heart (self)","to":275281,"res":"span"},{"n":105,"l":"bearer","k":"pair","v":"David","to":275281,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"none","res":"none"},{"n":107,"l":"target","k":"pair","v":"none","res":"none"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"its meditation to be acceptable","from":275281,"to":275283,"res":"span"},{"n":116,"l":"locus","k":"value","v":"internal:seat"},{"n":114,"l":"discovery","k":"note","v":"'the MEDITATION of my HEART (lev) be acceptable' — the inner speech submitted to God; this lev's silent musing, like the words of the mouth, is offered for divine approval — the heart that was gladdened by the word (v8) now asks that its own thought please God"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "275283": {"gloss":"acceptable v14","dims":[{"n":101,"l":"sense","k":"value","v":"acceptable / favour (ratson)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"the words and meditation (to be acceptable)","from":275283,"to":275281,"res":"span"},{"n":106,"l":"operation","k":"event","v":"none","res":"none"},{"n":107,"l":"target","k":"pair","v":"God ('in your sight')","to":275283,"res":"inferred"},{"n":108,"l":"manner","k":"pair","v":"in your sight","to":275283,"res":"inferred"},{"n":112,"l":"coupling","k":"pair","v":"of mouth and heart","from":275283,"to":275281,"res":"span"},{"n":116,"l":"locus","k":"value","v":"external:god"},{"n":114,"l":"discovery","k":"note","v":"'be ACCEPTABLE (ratson) in your sight' — the plea for divine favour on word and thought; ratson = God's good-pleasure, the standard by which the whole inner and outer life is measured, closing the psalm"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "275287": {"gloss":"redeemer v14","dims":[{"n":101,"l":"sense","k":"value","v":"redeemer / kinsman-redeemer (gaal)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":104,"l":"seat","k":"pair","v":"none","res":"none"},{"n":105,"l":"bearer","k":"pair","v":"God ('my rock and my redeemer')","to":275287,"res":"inferred"},{"n":106,"l":"operation","k":"event","v":"none","res":"none"},{"n":107,"l":"target","k":"pair","v":"David","to":275287,"res":"inferred"},{"n":108,"l":"manner","k":"pair","v":"none","res":"none"},{"n":112,"l":"coupling","k":"pair","v":"none","res":"none"},{"n":116,"l":"locus","k":"value","v":"external:god"},{"n":114,"l":"discovery","k":"note","v":"'O LORD, my rock and my REDEEMER (gaal)' — God as the kinsman who buys back; gaal = the near-relative who redeems, the intimate title on which the whole prayer for cleansing rests"},{"n":115,"l":"role","k":"value","v":"characteristic"}]},
    "275302": {"gloss":"heard v3","dims":[{"n":101,"l":"sense","k":"value","v":"hear (shama - voice not heard)"},{"n":102,"l":"type","k":"value","v":"status"},{"n":114,"l":"discovery","k":"note","v":"v3-4: 'There is no speech nor words whose voice is not HEARD (shama); their voice goes out through all the earth' - the paradox of creation's silent-yet-universal testimony; wordless speech understood everywhere, God's witness needing no language"},{"n":115,"l":"role","k":"value","v":"standalone"}]},
    "275258": {"gloss":"keeping v11","dims":[{"n":101,"l":"sense","k":"value","v":"keep / observe (shamar - in keeping them)"},{"n":102,"l":"type","k":"value","v":"action"},{"n":114,"l":"discovery","k":"note","v":"v11: 'by them your servant is warned; in KEEPING (shamar) them there is great reward' - the word both warns and rewards; the inner posture of heeding, the servant instructed and moved by the promise of reward, obedience as the response to the treasured law (v10)"},{"n":115,"l":"role","k":"value","v":"standalone"}]}
