{
  "permissions": {
    "allow": [
      "PowerShell(.\\\\iba\\\\app\\\\ps\\\\Escalation.ps1 -Action AnswerRun -RunId RUN-20260722_065351_662-CONFIGMAINT -Decision Approve)",
      "PowerShell(.\\\\iba\\\\app\\\\ps\\\\Config-Maintenance.ps1 -Step Validate -RunId RUN-20260722_065351_662-CONFIGMAINT)"
    ],
    "deny": [
      "AskUserQuestion"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "pwsh -NoProfile -File \"$CLAUDE_PROJECT_DIR/.claude/statusline-devmode.ps1\""
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop_check_escalation_backlog.py\"",
            "timeout": 15,
            "statusMessage": "Checking escalation backlog..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/session_boundary_track.py\"",
            "timeout": 10,
            "statusMessage": "Recording session boundary..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/track_prompt_submit.py\"",
            "timeout": 10,
            "statusMessage": "Tracking prompt sequence..."
          }
        ]
      }
    ],
    "UserPromptExpansion": [
      {
        "matcher": "developer-mode",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/gate_developer_mode_entry.py\"",
            "timeout": 10,
            "statusMessage": "Checking Developer Mode session-freshness gate..."
          }
        ]
      }
    ]
  }
}
