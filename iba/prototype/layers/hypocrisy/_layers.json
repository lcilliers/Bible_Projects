{
  "word": "hypocrisy",
  "principle": "one table per SEARCH LAYER. The table is what the call returned — nothing interpreted, nothing dropped, nothing renamed.",
  "layers": [
    {
      "layer": 1,
      "call": "masterSearch  version=<v>|meanings=<word>",
